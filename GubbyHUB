task.spawn(function()
    local RunService = game:GetService("RunService")
    local TweenService = game:GetService("TweenService")
    local LocalPlayer = game:GetService("Players").LocalPlayer

    -- Ищем саму прокрутку контента, которая у тебя точно есть на экране
    local Container = game:GetService("CoreGui"):FindFirstChild("ContainerScroller", true)
    
    -- Находим фрейм первой вкладки (Игрок)
    local PlayerPage = Container and Container:FindFirstChildOfClass("Frame")

    if PlayerPage then
        -- 1. Создаем плашку тумблера под твой дизайн
        local ToggleFrame = Instance.new("Frame")
        ToggleFrame.Size = UDim2.new(0, 360, 0, 52)
        ToggleFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        ToggleFrame.BackgroundTransparency = 0.2
        ToggleFrame.Parent = PlayerPage
        
        Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 12)
        local tfs = Instance.new("UIStroke", ToggleFrame)
        tfs.Color = Color3.fromRGB(65, 65, 70)
        
        -- 2. Текст
        local ToggleLabel = Instance.new("TextLabel", ToggleFrame)
        ToggleLabel.Size = UDim2.new(0.6, 0, 1, 0)
        ToggleLabel.Position = UDim2.new(0, 15, 0, 0)
        ToggleLabel.BackgroundTransparency = 1
        ToggleLabel.Text = "Проход сквозь стены (Noclip)"
        ToggleLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        ToggleLabel.Font = Enum.Font.SourceSansBold
        ToggleLabel.TextSize = 16
        ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        -- 3. Кнопка
        local SwitchBtn = Instance.new("TextButton", ToggleFrame)
        SwitchBtn.Size = UDim2.new(0, 42, 0, 20)
        SwitchBtn.Position = UDim2.new(1, -55, 0.5, -10)
        SwitchBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        SwitchBtn.Text = ""
        Instance.new("UICorner", SwitchBtn).CornerRadius = UDim.new(0, 10)
        
        -- Шарик
        local Circle = Instance.new("Frame", SwitchBtn)
        Circle.Size = UDim2.new(0, 14, 0, 14)
        Circle.Position = UDim2.new(0, 3, 0.5, -7)
        Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Instance.new("UICorner", Circle).CornerRadius = UDim.new(0, 7)
        
        -- 4. Логика
        local noclipConnection = nil
        local enabled = false
        
        SwitchBtn.MouseButton1Click:Connect(function()
            enabled = not enabled
            if enabled then
                TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = Color3.fromRGB(0, 0, 0)}):Play()
                
                noclipConnection = RunService.Stepped:Connect(function()
                    if LocalPlayer.Character then
                        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                            if part:IsA("BasePart") and part.CanCollide and part.Name ~= "HumanoidRootPart" and part.Name ~= "LeftLeg" and part.Name ~= "RightLeg" then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            else
                TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                
                if noclipConnection then
                    noclipConnection:Disconnect()
                    noclipConnection = nil
                end
            end
        end)
    end
end)
