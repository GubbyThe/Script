getgenv().GubbyCore.CreateTab = function(tabName)
    local TabButton = Instance.new("TextButton", TabScroller)
    TabButton.Size = UDim2.new(0, 110, 0, 42)
    TabButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    TabButton.Text = tabName
    TabButton.TextColor3 = Color3.fromRGB(150, 150, 155)
    TabButton.Font = Enum.Font.SourceSansBold
    TabButton.TextSize = 14
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 12)
    local bs = Instance.new("UIStroke", TabButton)
    bs.Color = Color3.fromRGB(55, 55, 60)
    
    local PageFrame = Instance.new("Frame", ContainerScroller)
    PageFrame.Size = UDim2.new(1, 0, 1, 0)
    PageFrame.BackgroundTransparency = 1
    PageFrame.Visible = false
    Instance.new("UIListLayout", PageFrame).Padding = UDim.new(0, 14)
    pages[tabName] = PageFrame
    
    TabButton.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.Visible = false end
        PageFrame.Visible = true
        for _, b in pairs(TabScroller:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
                b.TextColor3 = Color3.fromRGB(150, 150, 155)
                b:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(55, 55, 60)
            end
        end
        TabButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.TextColor3 = Color3.fromRGB(0, 0, 0)
        bs.Color = Color3.fromRGB(255, 255, 255)
    end)
    
    if firstPage then
        PageFrame.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.TextColor3 = Color3.fromRGB(0, 0, 0)
        bs.Color = Color3.fromRGB(255, 255, 255)
        firstPage = false
    end
    
    local function AddSlider(text, min, max, default, callback)
        local SliderFrame = Instance.new("Frame", PageFrame)
        SliderFrame.Size = UDim2.new(0.95, 0, 0, 60)
        SliderFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        SliderFrame.BackgroundTransparency = 0.2
        Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 12)
        Instance.new("UIStroke", SliderFrame).Color = Color3.fromRGB(65, 65, 70)
        
        local SliderLabel = Instance.new("TextLabel", SliderFrame)
        SliderLabel.Size = UDim2.new(0.6, 0, 0, 30)
        SliderLabel.Position = UDim2.new(0, 15, 0, 5)
        SliderLabel.BackgroundTransparency = 1
        SliderLabel.Text = text
        SliderLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        SliderLabel.Font = Enum.Font.SourceSansBold
        SliderLabel.TextSize = 16
        SliderLabel.TextXAlignment = Enum.TextXAlignment.Left
        
        local ValueLabel = Instance.new("TextLabel", SliderFrame)
        ValueLabel.Size = UDim2.new(0.3, 0, 0, 30)
        ValueLabel.Position = UDim2.new(0.65, 0, 0, 5)
        ValueLabel.BackgroundTransparency = 1
        ValueLabel.Text = tostring(default)
        ValueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        ValueLabel.Font = Enum.Font.SourceSansBold
        ValueLabel.TextSize = 16
        ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
        
        local SliderTrack = Instance.new("TextButton", SliderFrame)
        SliderTrack.Size = UDim2.new(1, -30, 0, 6)
        SliderTrack.Position = UDim2.new(0, 15, 0, 42)
        SliderTrack.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        SliderTrack.Text = ""
        Instance.new("UICorner", SliderTrack).CornerRadius = UDim.new(1, 0)
        
        local SliderFill = Instance.new("Frame", SliderTrack)
        SliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
        SliderFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(1, 0)
        
        local sliding = false
        local function updateSlider(input)
            local percentage = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
            SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
            local val = math.floor(min + (max - min) * percentage)
            ValueLabel.Text = tostring(val)
            if callback then pcall(callback, val) end
        end
        
        SliderTrack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true updateSlider(input) end
        end)
        game:GetService("UserInputService").InputChanged:Connect(function(input)
            if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input) end
        end)
        game:GetService("UserInputService").InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
        end)
    end
    
    local function AddTextLabel(title, text)
        local TextBlock = Instance.new("TextLabel", PageFrame)
        TextBlock.Size = UDim2.new(0.92, 0, 0, 70)
        TextBlock.BackgroundTransparency = 1
        TextBlock.Text = "<b>" .. title .. "</b>\n<i>" .. text .. "</i>"
        TextBlock.RichText = true
        TextBlock.TextColor3 = Color3.fromRGB(240, 240, 245)
        TextBlock.Font = Enum.Font.SourceSans
        TextBlock.TextSize = 16
        TextBlock.TextWrapped = true
        TextBlock.TextXAlignment = Enum.TextXAlignment.Left
        TextBlock.TextYAlignment = Enum.TextYAlignment.Top
    end
    
    return {AddSlider = AddSlider, AddInfo = AddTextLabel, RawPage = PageFrame}
end
