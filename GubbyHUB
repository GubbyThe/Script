_G.SaveGubbyConfig = function()
    pcall(function()
        if writefile then
            local dataToSave = {
                Speed = Config.PlayerMods.Speed,
                Jump = Config.PlayerMods.Jump,
                FlySpeed = Config.GubbyFly.Speed,
                BindKey = Config.GubbyUIBind.Key.Name,
                FlyKey = Config.KeyBinds.Fly.Key,
                FlyKeyToggle = Config.KeyBinds.Fly.Enabled,
                NoclipKey = Config.KeyBinds.Noclip.Key,
                NoclipKeyToggle = Config.KeyBinds.Noclip.Enabled,
                InfJumpKey = Config.KeyBinds.InfJump.Key,
                InfJumpKeyToggle = Config.KeyBinds.InfJump.Enabled
            }
            writefile(CONFIG_FILE, HttpService:JSONEncode(dataToSave))
        end
    end)
end

local function loadGubbyConfig()
    if readfile and isfile and isfile(CONFIG_FILE) then
        local success, result = pcall(function()
            local jsonText = readfile(CONFIG_FILE)
            if jsonText and jsonText ~= "" then
                return HttpService:JSONDecode(jsonText)
            end
        end)
        if success and result then
            if result.Speed then Config.PlayerMods.Speed = result.Speed end
            if result.Jump then Config.PlayerMods.Jump = result.Jump end
            if result.FlySpeed then Config.GubbyFly.Speed = result.FlySpeed end
            if result.BindKey then Config.GubbyUIBind.Key = Enum.KeyCode[result.BindKey] end
            if result.FlyKey then Config.KeyBinds.Fly.Key = result.FlyKey end
            if result.FlyKeyToggle ~= nil then Config.KeyBinds.Fly.Enabled = result.FlyKeyToggle end
            if result.NoclipKey then Config.KeyBinds.Noclip.Key = result.NoclipKey end
            if result.NoclipKeyToggle ~= nil then Config.KeyBinds.Noclip.Enabled = result.NoclipKeyToggle end
            if result.InfJumpKey then Config.KeyBinds.InfJump.Key = result.InfJumpKey end
            if result.InfJumpKeyToggle ~= nil then Config.KeyBinds.InfJump.Enabled = result.InfJumpKeyToggle end
        end
    end
end
