    -- 2. ВЫСОКОСКОРОСТНОЙ ВИРТУАЛЬНЫЙ ПОТОК НАЖАТИЯ МЫШКИ (FE CLICK SPAM)
    local clickerActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        clickerActive = false -- Мгновенно тушим поток при перезапуске хаба, спасая память
        if oldKill then oldKill() end
    end

    task.spawn(function()
        -- Используем виртуальный инструмент (VirtualUser) для симуляции реального клика по экрану
        local virtualUser = game:GetService("VirtualUser")
        
        while clickerActive do
            RS.Heartbeat:Wait() -- Сверхбыстрый клик на каждом тике игры (около 60+ кликов в секунду!)
            
            -- Если сработал глобальный ресет — выходим из цикла
            if not clickerActive then break end

            if Config.GubbyAutoclicker.Enabled then
                pcall(function()
                    -- Симулируем полноценный клик Левой Кнопкой Мыши (ЛКМ) в текущие координаты мыши
                    virtualUser:ClickButton1(Vector2.new(0, 0))
                end)
            end
        end
    end)

    print("[Gubby Модуль]: Автокликер успешно добавлен во вкладку 'Кнопки'!")
else
    print("[Gubby Ошибка]: Не удалось найти вкладку 'Кнопки'!")
