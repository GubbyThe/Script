-- ГУББИ ХАБ | МОДУЛЬ-ПРОДОЛЖЕНИЕ: ТЕЛЕПОРТ К ПИСТОЛЕТУ ДЛЯ ВКЛАДКИ "КОМБАТ"
-- ========================================================================
local W = game:GetService("Workspace")
local P = game:GetService("Players")
local LP = P.LocalPlayer

-- Находим контейнер твоей вкладки "Комбат"
local tabCombatSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do
        if t.name == "Комбат" then tabCombatSc = t.sc break end
    end
end

if tabCombatSc then
    -- Зачищаем старые кнопки комбата, если они были
    if tabCombatSc:FindFirstChild("GubbyTpToGunButton") then tabCombatSc.GubbyTpToGunButton:Destroy() end

    -- 1. СОЗДАЕМ КНОПКУ ТЕЛЕПОРТА К ОРУЖИЮ
    local TpGunBtn = Instance.new("TextButton", tabCombatSc)
    TpGunBtn.Name = "GubbyTpToGunButton"
    TpGunBtn.Size = UDim2.new(1, -10, 0, 32)
    TpGunBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    TpGunBtn.BackgroundTransparency = 0.5
    TpGunBtn.Text = "🔫 Телепорт к Пистолету (MM2)"
    TpGunBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    TpGunBtn.Font = Enum.Font.SourceSansBold
    TpGunBtn.TextScaled = true -- Железная защита текста
    Instance.new("UICorner", TpGunBtn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", TpGunBtn)
    btnStroke.Color = Color3.fromRGB(255, 105, 180) -- Твой розовый неон
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    -- 2. ЛОГИКА МГНОВЕННОГО ПЕРЕНЕСЕНИЯ НА ГАН
    TpGunBtn.MouseButton1Click:Connect(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- Ищем выпавший пистолет на карте MM2 по классическим путям
        local gunDrop = W:FindFirstChild("GunDrop", true) or W:FindFirstChild("Luger", true) or W:FindFirstChild("Grip", true)
        
        if gunDrop then
            -- Эффект вспышки кнопки при успешном поиске
            TpGunBtn.BackgroundTransparency = 0.1
            btnStroke.Transparency = 0.1
            TpGunBtn.TextColor3 = Color3.fromRGB(50, 150, 255)
            btnStroke.Color = Color3.fromRGB(50, 150, 255)

            pcall(function()
                -- Определяем точные 3D координаты пистолета
                local targetCFrame = gunDrop:IsA("BasePart") and gunDrop.CFrame or gunDrop.Parent.CFrame
                
                -- Сохраняем твою позицию до телепорта, чтобы вернуться назад [3, 7]
                local oldCFrame = root.CFrame
                
                -- Переносим тебя ровно на пистолет [3, 7]
                root.CFrame = targetCFrame + Vector3.new(0, 1, 0)
                
                -- Небольшая задержка в 0.2 секунды, чтобы Roblox успел засчитать поднятие предмета [7]
                task.wait(0.2)
                
                -- Возвращаем тебя обратно на безопасную позицию, где ты стоял [3, 7]
                root.Velocity = Vector3.zero
                root.CFrame = oldCFrame
            end)

            -- Возвращаем дефолтный стиль кнопки
            task.wait(0.5)
            if TpGunBtn then
                TpGunBtn.BackgroundTransparency = 0.5
                btnStroke.Transparency = 0.5
                TpGunBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
                btnStroke.Color = Color3.fromRGB(255, 105, 180)
            end
        else
            -- Если пистолет ещё не выпал (шериф жив), кнопка мигнёт красным ошибкой
            TpGunBtn.TextColor3 = Color3.fromRGB(255, 50, 50)
            TpGunBtn.Text = "❌ Пистолет не найден на карте!"
            task.wait(1.5)
            if TpGunBtn then
                TpGunBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
                TpGunBtn.Text = "🔫 Телепорт к Пистолету (MM2)"
            end
        end
    end)

    print("[Gubby Модуль]: Кнопка ТП к пистолету успешно добавлена во вкладку 'Комбат'!")
end
