local UIS = game:GetService("UserInputService")
local MainFrame = _G.GeminiUI.MainFrame
local EditorFrame = _G.GeminiUI.EditorFrame

-- Функция для привязки плавного изменения размера к любому фрейму
local function makeResizable(frame, minX, minY, layoutType)
    -- Удаляем старый уголок, если он существовал, во избежание дубликатов
    local oldCorner = frame:FindFirstChild("UniversalResizeCorner")
    if oldCorner then oldCorner:Destroy() end

    -- Создаем новую невидимую кнопку-уголок в правом нижнем углу окна
    local resizeCorner = Instance.new("ImageButton", frame)
    resizeCorner.Name = "UniversalResizeCorner"
    resizeCorner.Size = UDim2.new(0, 18, 0, 18)
    resizeCorner.Position = UDim2.new(1, -18, 1, -18)
    resizeCorner.BackgroundTransparency = 1
    resizeCorner.Image = "rbxassetid://10634621021" -- Четкая стрелочка ресайза
    resizeCorner.ZIndex = 10

    local isResizing = false
    local startSize, startMouse

    resizeCorner.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isResizing = true
            startSize = frame.AbsoluteSize
            startMouse = UIS:GetMouseLocation()
            
            -- Фиксируем состояние окончания зажатия мыши
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isResizing = false
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if isResizing and input.UserInputType == Enum.UserInputType.MouseMovement then
            local currentMouse = UIS:GetMouseLocation()
            local delta = currentMouse - startMouse
            
            -- Вычисляем новые размеры с жесткими границами минимального размера
            local newWidth = math.max(minX, startSize.X + delta.X)
            local newHeight = math.max(minY, startSize.Y + delta.Y)
            
            frame.Size = UDim2.new(0, newWidth, 0, newHeight)

            -- ЕСЛИ ЭТО ГЛАВНОЕ ОКНО: Автоматически масштабируем внутренности (сайдбар, контент, список игроков)
            if layoutType == "Main" then
                local sidebar = _G.GeminiUI.Sidebar
                local content = _G.GeminiUI.ContentArea
                local plFrame = frame:FindFirstChild("Frame") and frame:FindFirstChild("Frame").Parent:FindFirstChildOfClass("Frame") or frame:FindFirstChildOfClass("Frame")
                
                if sidebar then
                    sidebar.Size = UDim2.new(0, 110, 1, -35)
                end
                -- Корректируем правую панель игроков, прижимая её к краю
                for _, child in ipairs(frame:GetChildren()) do
                    if child:IsA("Frame") and child ~= sidebar and child:FindFirstChild("ScrollingFrame") then
                        child.Size = UDim2.new(0, 150, 1, -45)
                        child.Position = UDim2.new(1, -155, 0, 40)
                    end
                end
                if content then
                    content.Size = UDim2.new(1, -275, 1, -45)
                    content.Position = UDim2.new(0, 115, 0, 40)
                end
            end
        end
    end)
end

-- Включаем динамический ресайз для Главного Окна (минимально 350x250)
if MainFrame then
    makeResizable(MainFrame, 380, 260, "Main")
end

-- Включаем динамический ресайз для Панели Создателя Стен (минимально 160x180)
