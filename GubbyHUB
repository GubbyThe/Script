local function clearHandles() if Config.WallEditor.HandleInstance then Config.WallEditor.HandleInstance:Destroy(); Config.WallEditor.HandleInstance = nil end end
local function attachHandles(part)
    clearHandles(); if not part then return end
    local h = Instance.new("Handles", ScreenGui); h.Name = "GeminiStudioHandles"; h.Color3 = Color3.fromRGB(59, 130, 246); h.Style = Enum.HandlesStyle.Resize; h.Adornee = part
    local startSize, startCFrame
    h.MouseButton1Down:Connect(function() startSize = part.Size; startCFrame = part.CFrame end)
    h.MouseDrag:Connect(function(face, distance)
        local inc = Config.WallEditor.Increment; local snapDist = math.round(distance / inc) * inc
        local normal = Vector3.FromNormalId(face); local sizeDelta = normal * snapDist
        part.Size = Vector3.new(math.max(1, startSize.X + sizeDelta.X), math.max(1, startSize.Y + sizeDelta.Y), math.max(1, startSize.Z + sizeDelta.Z))
        part.CFrame = startCFrame * CFrame.new(normal * ((part.Size - startSize) * 0.5))
    end)
    Config.WallEditor.HandleInstance = h
end

