-- Логика создания Белого Геометрического ESP (Боксов)
local function applyESP(player)
    if player == LP then return end
    local function createVisuals(char)
        if char:FindFirstChild("GubbyHighlight") then char.GubbyHighlight:Destroy() end
        local highlight = Instance.new("Highlight", char)
        highlight.Name = "GubbyHighlight"
        highlight.FillColor = Color3.fromRGB(240, 240, 240)
        highlight.FillTransparency = 0.7
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0.1
        highlight.Adornee = char
    end
    if player.Character then createVisuals(player.Character) end
    player.CharacterAdded:Connect(createVisuals)
end

-- Логика Белых Тросов через Beam (без использования Drawing API)
local function applyTracers(player)
    if player == LP then return end
    
    local function createBeam(char)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not root or not myRoot then return end
        
        if char:FindFirstChild("GubbyTracerBeam") then char.GubbyTracerBeam:Destroy() end
        
        local myAtt = myRoot:FindFirstChild("GubbyAttachment") or Instance.new("Attachment", myRoot)
        myAtt.Name = "GubbyAttachment"
        
        local targetAtt = Instance.new("Attachment", root)
        targetAtt.Name = "GubbyTargetAttachment"
        
        local beam = Instance.new("Beam", char)
        beam.Name = "GubbyTracerBeam"
        beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
        beam.Width0 = 0.05
        beam.Width1 = 0.05
        beam.FaceCamera = true
        beam.Attachment0 = myAtt
        beam.Attachment1 = targetAtt
        beam.Enabled = false
    end
    
    if player.Character then createBeam(player.Character) end
    player.CharacterAdded:Connect(createBeam)
end

-- Цикл обновлений Визуалов
RS.RenderStepped:Connect(function()
    if not scriptActive then return end
    
    for _, player in ipairs(P:GetPlayers()) do
        local char = player.Character
        if char then
            local highlight = char:FindFirstChild("GubbyHighlight")
            local beam = char:FindFirstChild("GubbyTracerBeam")
            
            -- Боксы
            if Config.GubbyESP.Enabled then
                if not highlight then applyESP(player) else highlight.Enabled = true end
            else
                if highlight then highlight.Enabled = false end
            end
            
            -- Тросы
            if Config.GubbyTracers.Enabled then
                if not beam then applyTracers(player) else beam.Enabled = true end
            else
                if beam then beam.Enabled = false end
            end
        end
    end
end)

