_G.GeminiUI.CreateSlider = function(text, min, max, def, parent, lo, cb)
    local sf = Instance.new("Frame", parent); sf.Size = UDim2.new(1, -10, 0, 42); sf.BackgroundTransparency = 1; sf.LayoutOrder = lo
    local lbl = Instance.new("TextLabel", sf); lbl.Size = UDim2.new(1, 0, 0, 16); lbl.Text = text .. ": " .. tostring(def); lbl.Font = Enum.Font.SourceSansBold; lbl.TextColor3 = Color3.fromRGB(255, 255, 255); lbl.TextSize = 12; lbl.BackgroundTransparency = 1
    local sbg = Instance.new("Frame", sf); sbg.Size = UDim2.new(1, -20, 0, 6); sbg.Position = UDim2.new(0, 10, 0, 22); sbg.BackgroundColor3 = Color3.fromRGB(220, 200, 30); sbg.BackgroundTransparency = 0.4
    local sfl = Instance.new("Frame", sbg); local dr = (def - min) / (max - min); sfl.Size = UDim2.new(dr, 0, 1, 0); sfl.BackgroundColor3 = Color3.fromRGB(255, 152, 0)
    local trg = Instance.new("TextButton", sbg); trg.Size = UDim2.new(0, 12, 0, 12); trg.Position = UDim2.new(dr, -6, 0, -3); trg.BackgroundColor3 = Color3.fromRGB(0, 0, 0); trg.Text = ""
    local sld = false
    local function upd(i)
        local p = math.clamp((i.Position.X - sbg.AbsolutePosition.X) / sbg.AbsoluteSize.X, 0, 1)
        sfl.Size = UDim2.new(p, 0, 1, 0); trg.Position = UDim2.new(p, -6, 0, -3)
        local v = math.floor(min + (p * (max - min))); lbl.Text = text .. ": " .. tostring(v); cb(v)
    end
    trg.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sld = true end end)
    game:GetService("UserInputService").InputChanged:Connect(function(i) if sld and i.UserInputType == Enum.UserInputType.MouseMovement then upd(i) end end)
    game:GetService("UserInputService").InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sld = false end end)
end

