-- ================= 2. УМНЫЙ ПОИСК ЯИЦ ОТ EASTER BUNNY / MIMIC =================
local function isInvalidTarget(item)
    local fullName = item:GetFullName()
    if fullName:find("PetsPhysical") or fullName:find("Shop") or fullName:find("Interaction") then
        return true
    end
    local current = item.Parent
    while current and current ~= Workspace do
        if current:FindFirstChildOfClass("Humanoid") then
            return true
        end
        current = current.Parent
    end
    return false
end

local function getEggPart(eggObj)
    if eggObj:IsA("BasePart") then
        return eggObj
    elseif eggObj:IsA("Model") then
        if eggObj.PrimaryPart then return eggObj.PrimaryPart end
        -- Ищем любую деталь с ненулевыми координатами
        for _, d in ipairs(eggObj:GetDescendants()) do
            if d:IsA("BasePart") and d.Position.Magnitude > 1 then
                return d
            end
        end
        return eggObj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

-- Функция полного прожима всех триггеров сбора внутри яйца
local function collectEgg(eggObj, root)
    for _, d in ipairs(eggObj:GetDescendants()) do
        if d:IsA("ProximityPrompt") and fireproximityprompt then
            pcall(fireproximityprompt, d)
        elseif d:IsA("ClickDetector") and fireclickdetector then
            pcall(fireclickdetector, d)
        elseif d:IsA("BasePart") and firetouchinterest then
            pcall(function()
                firetouchinterest(root, d, 0)
                firetouchinterest(root, d, 1)
            end)
        end
    end
    if eggObj:IsA("BasePart") and firetouchinterest then
        pcall(function()
            firetouchinterest(root, eggObj, 0)
            firetouchinterest(root, eggObj, 1)
        end)
    end
end

