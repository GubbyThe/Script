-- [СИСТЕМА КОНФИГОВ ПО НИКУ И АВТО-МЕТЛА ДЛЯ GUBBYHUB]
-- ========================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local username = LocalPlayer.Name

-- Имя файла конфигурации для Соляры
local configFile = "GubbyHub_Broom_" .. username .. ".txt"

-- Функция сохранения конфига (записывает данные на ПК)
local function saveConfig(status)
    if writefile then
        writefile(configFile, tostring(status))
    end
end

-- Функция загрузки конфига (читает данные даже после ребута ПК)
local function loadConfig()
    if isfile and readfile and isfile(configFile) then
        local content = readfile(configFile)
        return content == "true"
    end
    return false -- По умолчанию выключено
end

-- Инициализируем статус из файла подкачки
local BroomAutoEquip = loadConfig()

-- ТУТ ТВОЙ СКРИПТ ДОЛЖЕН ОТПРАВИТЬ СИГНАЛ ИГРЕ ДЛЯ ЭКИПИРОВКИ
local function useBroomRemotely()
    task.wait(2) -- Ждем загрузки раунда
    if not BroomAutoEquip then return end
    
    -- Симуляция клика через Ремоут Ивенты MM2 (Никилис использует их для экипировки игрушек)
    -- В зависимости от версии обновления, ивент может лежать в ReplicatedStorage
    local equipEvent = ReplicatedStorage:FindFirstChild("EquipToy", true) or ReplicatedStorage:FindFirstChild("EquipItem", true)
    
    if equipEvent and equipEvent:IsA("RemoteEvent") then
        -- Передаем серверу имя предмета, имитируя, что мы открыли меню и кликнули по метле
        equipEvent:FireServer("Broom Toy") 
        
        -- Даем микро-паузу и активируем полет
        task.wait(0.5)
        local characterBroom = LocalPlayer.Character:FindFirstChild("Broom Toy")
        if characterBroom and characterBroom:IsA("Tool") then
            characterBroom:Activate()
        end
    end
end

-- Срабатывание при каждом респавне
LocalPlayer.CharacterAdded:Connect(function(character)
    if BroomAutoEquip then
        useBroomRemotely()
    end
end)

