local function getMM2Color(player)
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    
    -- Проверка на Убийцу (Красный)
    if (char and char:FindFirstChild("Knife")) or (backpack and backpack:FindFirstChild("Knife")) then
        return Color3.fromRGB(255, 50, 50)
    end
    
    -- Проверка на Шерифа (Синий)
    if (char and (char:FindFirstChild("Gun") or char:FindFirstChild("GunDrop"))) or 
       (backpack and (backpack:FindFirstChild("Gun") or backpack:FindFirstChild("GunDrop"))) then
        return Color3.fromRGB(50, 150, 255)
    end
    
    -- Обычный игрок (Белый)
    return Color3.fromRGB(240, 240, 240)
end

