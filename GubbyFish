-- ================= 7. ATTACH ORBIT FLING =================
local activeButtons = {}

local function updateFlingList()
    for _, b in pairs(activeButtons) do
        pcall(function() b:Destroy() end)
    end
    table.clear(activeButtons)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            local pBtn = Instance.new("TextButton", FlingScroll)
            pBtn.Size = UDim2.new(0.96, 0, 0, 24)
            pBtn.BackgroundColor3 = Color3.fromRGB(35, 20, 20)
            pBtn.BackgroundTransparency = 0.4
            pBtn.Text = "🚀 Отправить: " .. player.Name
            pBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
            pBtn.Font = Enum.Font.SourceSansBold
            pBtn.TextSize = 12
            pBtn.TextScaled = true
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            
            local pStroke = Instance.new("UIStroke", pBtn)
            pStroke.Color = Color3.fromRGB(200, 60, 60)
            pStroke.Thickness = 0.8

            pBtn.MouseButton1Click:Connect(function()
                if isFlinging then return end
                local myChar = LP.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                local enemyChar = player.Character
                local enemyRoot = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
                
                if myRoot and myHum and enemyRoot then
                    isFlinging = true
                    pBtn.Text = "💥 ПРИВЯЗКА И НАКРУТКА..."
                    
                    local oldCFrame = myRoot.CFrame
                    local originalSpeed = myHum.WalkSpeed
                    myHum.WalkSpeed = 250
                    
                    local angle = 0
                    local attackTime = 0
                    local targetSentToSpace = false
                    
                    while attackTime < 3.0 and not targetSentToSpace do
                        local dt = RunService.Heartbeat:Wait()
                        attackTime = attackTime + dt
                        
                        if not player or not player.Character or not enemyRoot.Parent then break end
                        
                        angle = angle + 45
                        local offset = Vector3.new(math.sin(angle) * 0.5, 0, math.cos(angle) * 0.5)
                        
                        myRoot.CFrame = CFrame.new(enemyRoot.Position + offset)
                        myRoot.AssemblyLinearVelocity = Vector3.new(500000, 500000, 500000)
                        myRoot.AssemblyAngularVelocity = Vector3.new(500000, 500000, 500000)
                        
                        if (enemyRoot.Position - oldCFrame.Position).Magnitude > 70 then
                            targetSentToSpace = true
                        end
                    end

                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    myRoot.AssemblyAngularVelocity = Vector3.zero
                    myHum.WalkSpeed = originalSpeed
                    myRoot.CFrame = oldCFrame
                    
                    pBtn.Text = "🛡️ СБРОС СКОРОСТИ (1 сек)..."
                    task.wait(1.0)
                    
                    pBtn.Text = "🚀 Отправить: " .. player.Name
                    isFlinging = false
                end
            end)
            table.insert(activeButtons, pBtn)
        end
    end
end

addConn(Players.PlayerAdded:Connect(updateFlingList))
