        head.CFrame = root.CFrame * CFrame.new(0, 1.8, 0)
        
        -- Накладываем текстуру рожицы Губби на переднюю часть головы
        local faceDecal = Instance.new("Decal", head)
        faceDecal.Texture = gubbyTexture
        faceDecal.Face = Enum.NormalId.Front
        
        -- Натягиваем текстуры на торс со всех сторон для визуала
        local faces = {Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Back}
        for _, face in ipairs(faces) do
            local tex = Instance.new("Texture", body)
            tex.Texture = gubbyTexture
            tex.Face = face
            tex.StudsPerTileU = 2
            tex.StudsPerTileV = 2
        end
        
        -- Привариваем детали к HumanoidRootPart
        local function weldParts(p0, p1)
            local w = Instance.new("WeldConstraint", p1)
            w.Part0 = p0
            w.Part1 = p1
        end
        weldParts(root, body)
        weldParts(root, head)
        
    else
        btn.Text = "🦊 3D Губби-Морф v2.0"
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        if morphFolder then morphFolder:Destroy() morphFolder = nil end
        if char then setLegoCharVisibility(char, true) end
    end
end)

LP.CharacterAdded:Connect(function()
    legoMorphActive = false
    if morphFolder then morphFolder:Destroy() morphFolder = nil end
end)
