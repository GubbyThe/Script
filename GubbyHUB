local TweenService = game:GetService("TweenService")
local MainFrame = getgenv().GubbyCore.MainFrame
local TabContainer = getgenv().GubbyCore.TabContainer
local PagesContainer = getgenv().GubbyCore.PagesContainer

local function CreateTab(Name)
    -- Кнопка вкладки в левом меню (Твой оригинальный стиль)
    local TabButton = Instance.new("TextButton", TabContainer)
    TabButton.Size = UDim2.new(0.9, 0, 0, 38)
    TabButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    TabButton.BackgroundTransparency = 0.4
    TabButton.Text = Name
    TabButton.TextColor3 = Color3.fromRGB(200, 200, 200)
    TabButton.Font = Enum.Font.SourceSansBold
    TabButton.TextSize = 14
    Instance.new("UICorner", TabButton).CornerRadius = UDim.new(0, 8)
    local TabStroke = Instance.new("UIStroke", TabButton)
    TabStroke.Color = Color3.fromRGB(55, 55, 60)
    TabStroke.Thickness = 1

    -- Контейнер страницы для элементов управления
    local RawPage = Instance.new("ScrollingFrame", PagesContainer)
    RawPage.Size = UDim2.new(1, 0, 1, 0)
    RawPage.BackgroundTransparency = 1
    RawPage.Visible = false
    RawPage.ScrollBarThickness = 2
    RawPage.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 85)
    
    local ListLayout = Instance.new("UIListLayout", RawPage)
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ListLayout.Padding = UDim.new(0, 10)
    ListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    -- Авто-размер холста, чтобы элементы не слипались
    ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        RawPage.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 20)
    end)

    -- Переключение вкладок при клике
    TabButton.MouseButton1Click:Connect(function()
        for _, page in pairs(PagesContainer:GetChildren()) do
            if page:IsA("ScrollingFrame") then page.Visible = false end
        end
        for _, btn in pairs(TabContainer:GetChildren()) do
            if btn:IsA("TextButton") then 
                TweenService:Create(btn, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(200, 200, 200), BackgroundColor3 = Color3.fromRGB(30, 30, 35)}):Play()
            end
        end
        RawPage.Visible = true
        TweenService:Create(TabButton, TweenInfo.new(0.2), {TextColor3 = Color3.fromRGB(255, 255, 255), BackgroundColor3 = Color3.fromRGB(50, 50, 55)}):Play()
    end)

    -- Сделай первую созданную вкладку видимой по умолчанию
    if #TabContainer:GetChildren() == 3 then -- учитывая UIListLayout
        RawPage.Visible = true
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    end

    return {
        RawPage = RawPage,
        
        -- Функция добавления Слайдера (Твой оригинальный дизайн)
        AddSlider = function(text, min, max, default, callback)
            local SFrame = Instance.new("Frame", RawPage)
            SFrame.Size = UDim2.new(0.95, 0, 0, 65)
            SFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            SFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", SFrame).CornerRadius = UDim.new(0, 12)
            local SStroke = Instance.new("UIStroke", SFrame)
            SStroke.Color = Color3.fromRGB(65, 65, 70)

            local SLbl = Instance.new("TextLabel", SFrame)
            SLbl.Size = UDim2.new(0.7, 0, 0, 25)
            SLbl.Position = UDim2.new(0, 15, 0, 8)
            SLbl.BackgroundTransparency = 1
            SLbl.Text = text
            SLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
            SLbl.Font = Enum.Font.SourceSansBold
            SLbl.TextSize = 15
            SLbl.TextXAlignment = Enum.TextXAlignment.Left

            local ValLbl = Instance.new("TextLabel", SFrame)
            ValLbl.Size = UDim2.new(0.2, 0, 0, 25)
            ValLbl.Position = UDim2.new(1, -65, 0, 8)
            ValLbl.BackgroundTransparency = 1
            ValLbl.Text = tostring(default)
            ValLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
            ValLbl.Font = Enum.Font.Code
            ValLbl.TextSize = 14
            ValLbl.TextXAlignment = Enum.TextXAlignment.Right

            local SBar = Instance.new("TextButton", SFrame)
            SBar.Size = UDim2.new(0.9, 0, 0, 6)
            SBar.Position = UDim2.new(0.05, 0, 1, -18)
            SBar.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
            SBar.Text = ""
            Instance.new("UICorner", SBar).CornerRadius = UDim.new(0, 3)

            local SFill = Instance.new("Frame", SBar)
            SFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            SFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Instance.new("UICorner", SFill).CornerRadius = UDim.new(0, 3)

            local function update(input)
                local unit = math.clamp((input.Position.X - SBar.AbsolutePosition.X) / SBar.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + (max - min) * unit)
                SFill.Size = UDim2.new(unit, 0, 1, 0)
                ValLbl.Text = tostring(value)
                callback(value)
            end

            local sliding = false
            SBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true update(input) end
            end)
            game:GetService("UserInputService").InputChanged:Connect(function(input)
                if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
            end)
            game:GetService("UserInputService").InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
            end)
        end,

        -- Функция Информационных строк для третьей части (Защита от нил-ошибки)
        AddInfo = function(titleText, descText)
            local InfoFrame = Instance.new("Frame", RawPage)
            InfoFrame.Size = UDim2.new(0.95, 0, 0, 52)
            InfoFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
            InfoFrame.BackgroundTransparency = 0.2
            Instance.new("UICorner", InfoFrame).CornerRadius = UDim.new(0, 12)
            local IStroke = Instance.new("UIStroke", InfoFrame)
            IStroke.Color = Color3.fromRGB(65, 65, 70)
            
            local Txt1 = Instance.new("TextLabel", InfoFrame)
            Txt1.Size = UDim2.new(0.4, 0, 1, 0)
            Txt1.Position = UDim2.new(0, 15, 0, 0)
            Txt1.BackgroundTransparency = 1
            Txt1.Text = titleText
            Txt1.TextColor3 = Color3.fromRGB(160, 160, 165)
            Txt1.Font = Enum.Font.SourceSansBold
            Txt1.TextSize = 14
            Txt1.TextXAlignment = Enum.TextXAlignment.Left
            
            local Txt2 = Instance.new("TextLabel", InfoFrame)
            Txt2.Size = UDim2.new(0.55, 0, 1, 0)
            Txt2.Position = UDim2.new(0.42, 0, 0, 0)
            Txt2.BackgroundTransparency = 1
            Txt2.Text = descText
            Txt2.TextColor3 = Color3.fromRGB(230, 230, 230)
            Txt2.Font = Enum.Font.SourceSans
            Txt2.TextSize = 14
            Txt2.TextXAlignment = Enum.TextXAlignment.Left
        end
    end
end

