UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if Config.GubbyUIBind.Listening then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            Config.GubbyUIBind.Key = input.KeyCode
            Config.GubbyUIBind.Listening = false
            _G.SaveGubbyConfig()
        end
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local pressedKey = input.KeyCode.Name
        if input.KeyCode == Config.GubbyUIBind.Key then MainFrame.Visible = not MainFrame.Visible
        elseif pressedKey == Config.KeyBinds.Fly.Key then Config.GubbyFly.Enabled = not Config.GubbyFly.Enabled
        elseif pressedKey == Config.KeyBinds.Noclip.Key then Config.GubbyNoclip.Enabled = not Config.GubbyNoclip.Enabled
        elseif pressedKey == Config.KeyBinds.InfJump.Key then Config.InfJump.Enabled = not Config.InfJump.Enabled end
    end
end)

task.spawn(function()
    while scriptActive do
        if Config.GubbyFly.Enabled then
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                W.Gravity = 0
                local moveDir = Vector3.new(0,0,0)
                if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Cam.CFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Cam.CFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0,1,0) end
                root.Velocity = moveDir.Unit * Config.GubbyFly.Speed
                if moveDir.Magnitude == 0 then root.Velocity = Vector3.new(0,0,0) end
            end
        else
            if W.Gravity == 0 then W.Gravity = Config.PlayerMods.Gravity end
        end
        task.wait()
    end
end)

