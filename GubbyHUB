    AttackBtn.Text = "🚀 Атака: Спинбот-Таран (По целям)"
    AttackBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    AttackBtn.Font = Enum.Font.SourceSansBold
    AttackBtn.TextScaled = true
    Instance.new("UICorner", AttackBtn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", AttackBtn)
    btnStroke.Color = Color3.fromRGB(255, 105, 180)
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    -- Переключатель логики кнопки
    local coordinatesBeforeAttack = nil
    AttackBtn.MouseButton1Click:Connect(function()
        Config.GubbyTroll.Enabled = not Config.GubbyTroll.Enabled
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        
        if Config.GubbyTroll.Enabled then
            AttackBtn.BackgroundTransparency = 0.1
            btnStroke.Transparency = 0.1
            AttackBtn.TextColor3 = Color3.fromRGB(255, 50, 50) -- Загорается агрессивным красным при пуске ракеты
            btnStroke.Color = Color3.fromRGB(255, 50, 50)
            
            -- ТВОЯ ИДЕЯ: Намертво запоминаем координаты, где была нажата кнопка!
            if root then coordinatesBeforeAttack = root.CFrame end
        else
            AttackBtn.BackgroundTransparency = 0.5
            btnStroke.Transparency = 0.5
            AttackBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
            btnStroke.Color = Color3.fromRGB(255, 105, 180)
            
            -- ТВОЯ ИДЕЯ: Полностью сбрасываем всю скорость и телепортируем назад!
            if root then
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                if coordinatesBeforeAttack then
                    task.wait(0.03) -- Микро-пауза для физического движка
                    root.CFrame = coordinatesBeforeAttack
                    coordinatesBeforeAttack = nil
                end
            end
        end
    end)

    -- 2. ВЫСОКОСКОРОСТНОЙ ПОТОК ЖЕСТКОГО СУПЕР-СПИНБОТА И НАПРАВЛЕННОГО ПОЛЕТА К ЦЕЛИ
    local taranActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        taranActive = false
        if oldKill then oldKill() end
    end

    RS.Heartbeat:Connect(function()
        if not taranActive or not Config.GubbyTroll.Enabled then return end
        
        local char = LP.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        -- Проверяем, выбран ли кто-то прямо сейчас на правой панели целей (выделен красным)
        local targetPlayer = nil
        for player, isSelected in pairs(Config.GubbyTroll.Targets) do
            if isSelected and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")
                if enemyHum and enemyHum.Health > 0 then
                    targetPlayer = player
                    break
                end
            end
        end

        -- Если цель выбрана — летим на неё со спинботом, багуя физику
        if targetPlayer then
            local enemyRoot = targetPlayer.Character.HumanoidRootPart
            
            -- Отключаем коллизии рук и ног, чтобы они работали как пропеллеры, а не спотыкались
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then 
                    part.CanCollide = false 
                end
            end

            -- СУПЕР СПИНБОТ: Выкручиваем дикую скорость вращения таза по оси Y
            myRoot.RotVelocity = Vector3.new(0, 250, 0)
            myRoot.AssemblyAngularVelocity = Vector3.new(0, 250, 0)

            -- НАСТРАИВАЕМЫЙ НАПРАВЛЕННЫЙ ПОЛЕТ: Плавно, но на бешеной скорости сближаемся с торсом жертвы
            -- Мы считаем вектор направления до цели
            local distanceVector = (enemyRoot.Position - myRoot.Position)
            local currentDist = distanceVector.Magnitude
            
            if currentDist > 0.5 then
                -- Скорость полёта-сближения (65 студов в тик — это ультра-быстро и сносит хитбоксы!)
                local taranFlySpeed = 65
                myRoot.Velocity = distanceVector.Unit * taranFlySpeed
                myRoot.AssemblyLinearVelocity = distanceVector.Unit * taranFlySpeed
                
                -- Сдвигаем CFrame по направлению полета, чтобы пробивать коллизию
                myRoot.CFrame = myRoot.CFrame + (distanceVector.Unit * 1.5)
            end
        else
            -- Если целей нет, просто гасим вращение
            myRoot.RotVelocity = Vector3.zero
        end
    end)

    print("[Gubby Модуль]: Ультимативная ракета-таран с авто-возвратом успешно загружена!")
end
