task.spawn(function()
    local t = 0
    while true do
        task.wait(0.02)
        if Config.ToxicTroll.Enabled and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            local root = LP.Character.HumanoidRootPart
            local targetPlayer = nil
            
            -- Ищем активную цель из выбранных в списке справа
            for p, active in pairs(Config.Fling.Targets) do
                if active and p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    targetPlayer = p
                    break
                end
            end
            
            -- Если цель в списке не выбрана, ищем ближайшего игрока в радиусе 50 единиц
            if not targetPlayer then
                local minDist = 50
                for _, p in ipairs(P:GetPlayers()) do
                    if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local d = (root.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < minDist then
                            minDist = d
                            targetPlayer = p
                        end
                    end
                end
            end
            
            -- Намертво привязываемся к жертве СВЕРХУ на правильном уровне высоты
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local tRoot = targetPlayer.Character.HumanoidRootPart
                t = t + 0.6 -- Скорость фрикций из Thunder Hub
                
                -- Движение вперед-назад
                local pushOffset = math.sin(t) * 1.4 
                
                -- Отключаем коллизии, чтобы не сломать физику Roblox
                for _, part in ipairs(LP.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
