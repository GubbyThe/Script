task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        local deltaTime = RunService.Heartbeat:Wait()
        
        if farmActive and not isFlinging and not isEscaping then
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and hum and hum.Health > 0 then
                local targetObj, targetPart = nil, nil
                local minDistance = math.huge

                if CURRENT_MODE == "GAG" then
                    -- РЕЖИМ GROW A GARDEN: Ищем EasterEggReward от петов
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj.Name == "EasterEggReward" and not isInvalidTarget(obj) then
                            local part = getPartFromObj(obj)
                            if part then
                                local dist = (part.Position - root.Position).Magnitude
                                if dist < minDistance then
                                    minDistance, targetObj, targetPart = dist, obj, part
                                end
                            end
                        end
                    end
                else
                    -- РЕЖИМ MM2 (И ПО УМОЛЧАНИЮ): Ищем монеты/яйца внутри карты раунда
                    checkMM2BagFull(hum)
                    local container = getMM2Container()
                    if container then
                        for _, obj in ipairs(container:GetDescendants()) do
                            if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
                                local item = obj.Parent
                                if item.Transparency < 0.9 and not isInvalidTarget(item) then
                                    local dist = (item.Position - root.Position).Magnitude
                                    if math.abs(item.Position.Y - root.Position.Y) < 18 and dist < minDistance then
                                        minDistance, targetObj, targetPart = dist, item, item
                                    end
                                end
                            end
                        end
                    end
                end

                if targetPart and hum.Health > 0 then
                    StatusLabel.Text = (isGAG and "🐰 Лечу к яйцу (" or "🔪 Собираю лут (") .. math.floor(minDistance) .. "м)..."
                    StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
                    
                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        
                        local targetPos = targetPart.Position
                        local direction = (targetPos - root.Position)
                        local distance = direction.Magnitude
                        
                        if distance > 1.8 then
                            local step = direction.Unit * (FARM_SPEED * deltaTime)
                            root.CFrame = (step.Magnitude > distance) and CFrame.new(targetPos) or (root.CFrame + step)
                        else
                            root.CFrame = CFrame.new(targetPos)
                            if firetouchinterest then
                                firetouchinterest(root, targetPart, 0)
                                firetouchinterest(root, targetPart, 1)
                            end
                            task.wait(0.06)
                        end
                    end)
                else
                    root.AssemblyLinearVelocity = Vector3.zero
                    if isGAG then
                        StatusLabel.Text = "🐰 Жду спавн EasterEggReward от петов..."
                        StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 100)
                    else
                        StatusLabel.Text = "💤 В лобби / Ожидание раунда MM2..."
                        StatusLabel.TextColor3 = Color3.fromRGB(180, 130, 50)
                    end
                end
            end
        end
    end
end)

-- ================= 5. АНТИ-МАРДЕР (ТОЛЬКО ДЛЯ РЕЖИМА MM2) =================
addConn(RunService.Heartbeat:Connect(function(dt)
    if CURRENT_MODE ~= "MM2" or isFlinging or not farmActive then
        isEscaping = false
        return
    end
    
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 or not getMM2Container() then
        isEscaping = false
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local enemyChar = player.Character
            local hasKnife = enemyChar:FindFirstChild("Knife") or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife"))
            if hasKnife and (enemyChar.HumanoidRootPart.Position - root.Position).Magnitude < 25 then
                isEscaping = true
                StatusLabel.Text = "⚠️ УГРОЗА: Мардер рядом! Сбегаю..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.zero
                    local flatDiff = Vector3.new(root.Position.X - enemyChar.HumanoidRootPart.Position.X, 0, root.Position.Z - enemyChar.HumanoidRootPart.Position.Z)
                    if flatDiff.Magnitude > 0.1 then
                        root.CFrame = root.CFrame + (flatDiff.Unit * (FARM_SPEED * dt))
                    end
                end)
                return
            end
        end
    end
    isEscaping = false
end))

