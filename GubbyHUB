    local function createGubbyTag(player)
        if player == LP then return end

        local function setupCharacter(char)
            local head = char:WaitForChild("Head", 5)
            if not head then return end

            -- Удаляем старый тег, если он остался от прошлых раундов
            if head:FindFirstChild("GubbyESP_Tag") then head.GubbyESP_Tag:Destroy() end

