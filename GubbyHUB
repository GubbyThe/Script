                        -- Сверяем по порядку или ищем по косвенным кнопкам (например Автокликер)
                        for _, btn in ipairs(child:GetChildren()) do
                            if btn:IsA("TextButton") and (btn.Text:lower():find("click") or btn.Text:lower():find("troll") or btn.Text:lower():find("анимац")) then
                                UtilsScrollFrame = child
                                break
                            end
                        end
                    end
                end
            end
            -- Если по кнопкам не определили, берем самую последнюю созданную вкладку
            if not UtilsScrollFrame then
                local frames = {}
                for _, child in ipairs(ContentArea:GetChildren()) do
                    if child:IsA("ScrollingFrame") then table.insert(frames, child) end
                end
                UtilsScrollFrame = frames[#frames] -- Вкладка Утилиты обычно создается последней
            end
        end
    end
end

-- Если прямой поиск не дал результатов, используем резервный из глобалки
if not UtilsScrollFrame and _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do
        if t.name == "Утилиты" then UtilsScrollFrame = t.sc break end
    end
end

if UtilsScrollFrame then
    -- Безопасно удаляем старую кнопку, если она зависла скрытой
    local oldBtn = UtilsScrollFrame:FindFirstChild("TouchFlingButton")
    if oldBtn then oldBtn:Destroy() end

    -- СОЗДАЕМ КНОПКУ НАПРЯМУЮ, ОБХОДЯ ВСЕ ОГРАНИЧЕНИЯ ТАБЛИЦ
    local CleanFlingButton = Instance.new("TextButton", UtilsScrollFrame)
    CleanFlingButton.Name = "TouchFlingButton"
    CleanFlingButton.Size = UDim2.new(1, -10, 0, 32)
    CleanFlingButton.BackgroundColor3 = Color3.fromRGB(255, 152, 0)
    CleanFlingButton.BackgroundTransparency = 0.4
    CleanFlingButton.Text = "Включить Touch Fling"
    CleanFlingButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    CleanFlingButton.Font = Enum.Font.SourceSansBold
    CleanFlingButton.TextScaled = true
    Instance.new("UICorner", CleanFlingButton).CornerRadius = UDim.new(0, 6)
    
    _G.GeminiUI.B_Refs.TouchFlingBtn = CleanFlingButton

    -- Логика нажатия
    CleanFlingButton.MouseButton1Click:Connect(function()
        G_Config.TouchFling.Enabled = not G_Config.TouchFling.Enabled
        CleanFlingButton.BackgroundColor3 = G_Config.TouchFling.Enabled and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(255, 152, 0)
    end)
    
    -- НАПРАВЛЕННЫЙ ФОНОВЫЙ ФЛИНГ-ПОТОК
    HeartbeatService.Heartbeat:Connect(function()
        local character = LP.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart or not G_Config.TouchFling.Enabled then return end

        local targetPlayer = nil
        for _, otherPlayer in ipairs(game:GetService("Players"):GetPlayers()) do
            if otherPlayer ~= LP and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local targetRoot = otherPlayer.Character.HumanoidRootPart
                local targetHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
                
                if targetHum and targetHum.Health > 0 and (rootPart.Position - targetRoot.Position).Magnitude <= 4 then
                    targetPlayer = otherPlayer
                    break
                end
            end
        end
        
        if targetPlayer then
            local tRoot = targetPlayer.Character.HumanoidRootPart
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = false end
            end
            
            local flingDirection = (tRoot.Position - rootPart.Position).Unit
            rootPart.Velocity = flingDirection * 500000
            HeartbeatService.Heartbeat:Wait()
            rootPart.Velocity = Vector3.new(0, 0, 0)
            rootPart.RotVelocity = Vector3.new(0, 0, 0)
        else
            if not G_Config.Spinbot.Enabled then rootPart.RotVelocity = Vector3.new(0, 0, 0) end
        end
    end)
    
    print("[Джимини Хаб v40.0]: Кнопка успешно врезана напрямую в интерфейс утилит!")
else
    print("[Джимини Ошибка]: Не удалось обнаружить фрейм утилит на экране. Убедись, что хаб запущен и вкладка 'Утилиты' существует!")
end
-- ========================================================================
-- ДЖИМИНИ ХАБ | РЕЖИМ БЛОК++ (АНТИ-МАГНИТ ЧЕРЕЗ АННИГИЛЯЦИЮ СУСТАВА РУКИ)
-- ========================================================================
local Config = _G.GeminiConfig
local b = _G.GeminiUI.B_Refs
local LP = game:GetService("Players").LocalPlayer
local W = game:GetService("Workspace")
local HeartbeatService = game:GetService("RunService")

local EdScroll = _G.GeminiUI.EdScroll or (_G.GeminiUI.EditorFrame and _G.GeminiUI.EditorFrame:FindFirstChild("ScrollingFrame"))

if EdScroll then
    if b.BuildBlockBtnEnhanced then pcall(function() b.BuildBlockBtnEnhanced:Destroy() end) end

    -- Чистая и аккуратная кнопка без скобочек в конце кода
    b.BuildBlockBtnEnhanced = _G.GeminiUI.CreateButton("Создать блок++", EdScroll, 6)

    b.BuildBlockBtnEnhanced.MouseButton1Click:Connect(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local backpack = LP:FindFirstChild("Backpack")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if root and backpack and hum then
            -- ТВОЯ ИДЕЯ: Находим и временно ломаем точку крепления к ладони, чтобы разорвать магнит!
            local rArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightUpperArm")
            local rHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Hand")
            
            -- Удаляем системные зацепы ладони локально
            if rHand then
                local attachment = rHand:FindFirstChild("RightGripAttachment")
                if attachment then attachment:Destroy() end
            end
            if rArm then
                local attachment = rArm:FindFirstChild("RightGripAttachment")
                if attachment then attachment:Destroy() end
            end

            -- Создаем реплицируемый Tool блок
            local feBlockTool = Instance.new("Tool")
            feBlockTool.Name = "GeminiBlock++"
            feBlockTool.RequiresHandle = true
            
            local handle = Instance.new("Part", feBlockTool)
            handle.Name = "Handle"
            handle.Size = Vector3.new(6, 6, 2)
            handle.Material = Enum.Material.Neon
            handle.Color = Color3.fromRGB(255, 235, 59)
            handle.CanCollide = true
            handle.Anchored = false 

            feBlockTool.Parent = backpack
            hum:EquipTool(feBlockTool)

            -- Позиция фиксации стены в пространстве карты
            local fixedCFrame = root.CFrame * CFrame.new(0, 0, -8)

            -- ПОТОК АНТИ-ПРИТЯЖЕНИЯ И УДЕРЖАНИЯ
            local connection
            connection = HeartbeatService.Heartbeat:Connect(function()
                if feBlockTool and feBlockTool.Parent == char and handle and handle.Parent then
                    -- Жестко зачищаем любые всплывающие суставы склейки в руке каждую миллисекунду
                    local grip = rArm and rArm:FindFirstChild("RightGrip") or (rHand and rHand:FindFirstChild("RightGrip"))
                    if grip then grip:Destroy() end
                    
                    local characterGrip = char:FindFirstChild("RightGrip", true)
                    if characterGrip then characterGrip:Destroy() end

                    -- Удерживаем деталь. Теперь ты свободен и не летишь к ней!
                    handle.CFrame = fixedCFrame
                    handle.Velocity = Vector3.new(0, 0.02, 0) -- Сетевой FE-пинг, чтобы блок видели все
                    handle.RotVelocity = Vector3.zero
                else
                    connection:Disconnect()
                end
            end)

            table.insert(_G.GeminiBlocksList, handle)
            Config.WallEditor.CurrentBlock = handle
            
            -- Подключаем синие стрелочки Handles для свободного изменения размеров
            if _G.GeminiUI.ScreenGui then
                local ScreenGui = _G.GeminiUI.ScreenGui
                local oldHandles = ScreenGui:FindFirstChild("GeminiStudioHandles")
                if oldHandles then oldHandles:Destroy() end
                
                local h = Instance.new("Handles", ScreenGui)
                h.Name = "GeminiStudioHandles"
                h.Color3 = Color3.fromRGB(59, 130,  Blue)
                h.Style = Enum.HandlesStyle.Resize
                h.Adornee = handle
                
                local startSize, startCFrame
                h.MouseButton1Down:Connect(function() startSize = handle.Size; startCFrame = handle.CFrame end)
                h.MouseDrag:Connect(function(face, distance)
                    local inc = Config.WallEditor.Increment or 1
                    local snapDist = math.round(distance / inc) * inc
                    local normal = Vector3.FromNormalId(face)
                    handle.Size = Vector3.new(math.max(1, startSize.X + (normal * snapDist).X), math.max(1, startSize.Y + (normal * snapDist).Y), math.max(1, startSize.Z + (normal * snapDist).Z))
                    handle.CFrame = startCFrame * CFrame.new(normal * ((handle.Size - startSize) * 0.5))
                    fixedCFrame = handle.CFrame -- Обновляем координаты для потока удержания
                end)
                Config.WallEditor.HandleInstance = h
            end
        end
    end)
    print("[Джимини Хаб v40.0]: Метод удаления ладонного зацепа активирован, магнит отключен намертво!")
end
