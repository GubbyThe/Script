local LP = P.LocalPlayer

-- Находим контейнер твоей вкладки "Игрок"
local tabPlayerSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do
        if t.name == "Игрок" then tabPlayerSc = t.sc break end
    end
end

if tabPlayerSc then
    -- Зачищаем старые кнопки самофлинга, если они зависли в памяти
    if tabPlayerSc:FindFirstChild("GubbySelfFlingButton") then tabPlayerSc.GubbySelfFlingButton:Destroy() end

    -- 1. СОЗДАЕМ КНОПКУ КАТАПУЛЬТИРОВАНИЯ
    local JupBtn = Instance.new("TextButton", tabPlayerSc)
    JupBtn.Name = "GubbySelfFlingButton"
    JupBtn.Size = UDim2.new(1, -10, 0, 32)
    JupBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    JupBtn.BackgroundTransparency = 0.5
    JupBtn.Text = "🪐 На Юпитер (Экстренный самофлинг)"
    JupBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    JupBtn.Font = Enum.Font.SourceSansBold
    JupBtn.TextScaled = true -- Железная защита от выползания длинного текста!
    Instance.new("UICorner", JupBtn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", JupBtn)
    btnStroke.Color = Color3.fromRGB(255, 105, 180) -- Фирменный розовый неон
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    -- 2. ЛОГИКА МГНОВЕННОГО ПИРАПАТАЛЬНОГО ВЗРЫВА ФИЗИКИ
    JupBtn.MouseButton1Click:Connect(function()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if root then
            pcall(function()
                -- Визуальный эффект нажатия (кнопка вспыхивает фиолетовым космосом)
                JupBtn.BackgroundTransparency = 0.1
                btnStroke.Transparency = 0.1
                JupBtn.TextColor3 = Color3.fromRGB(160, 50, 255)
                btnStroke.Color = Color3.fromRGB(160, 50, 255)

                -- Отключаем коллизию на микросекунду, чтобы серверный пол не задержал ракету
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                -- Жесткий пинок физического движка Roblox строго вверх (по оси Y) и закрутка суставов
                root.Velocity = Vector3.new(0, 800000, 0)
                root.RotVelocity = Vector3.new(800000, 800000, 800000)
                root.AssemblyLinearVelocity = Vector3.new(0, 800000, 0)
                root.AssemblyAngularVelocity = Vector3.new(800000, 800000, 800000)

                -- Возвращаем дефолтный стиль кнопки через полсекунды, пока ты летишь сквозь текстуры неба
                task.delay(0.5, function()
                    if JupBtn and btnStroke then
                        JupBtn.BackgroundTransparency = 0.5
                        btnStroke.Transparency = 0.5
                        JupBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
                        btnStroke.Color = Color3.fromRGB(255, 105, 180)
                    end
                end)
            end)
        end
    end)

    print("[Gubby Модуль]: Кнопка отправки на Юпитер успешно врезана во вкладку 'Игрок'!")
else
    print("[Gubby Ошибка]: Не удалось найти вкладку 'Игрок'!")
end
