    tBtn.Font = Enum.Font.SourceSansBold
    tBtn.TextSize = 13
    Instance.new("UICorner", tBtn).CornerRadius = UDim.new(0, 6)
    
    local btnStroke = Instance.new("UIStroke", tBtn)
    btnStroke.Color = Color3.fromRGB(240, 240, 240)
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.6
    
    local sc = Instance.new("ScrollingFrame", ContentArea)
    sc.Name = "Container_" .. tabName
    sc.Size = UDim2.new(1, 0, 1, 0)
    sc.BackgroundTransparency = 1
    sc.ScrollBarThickness = 3
    sc.ScrollBarImageColor3 = Color3.fromRGB(240, 240, 240)
    sc.Visible = false
    sc.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Instance.new("UIListLayout", sc).Padding = UDim.new(0, 6)
    
    tBtn.MouseButton1Click:Connect(function()
        for _, tab in pairs(_G.GubbyUI.Tabs) do 
            tab.sc.Visible = false
            tab.btn.BackgroundTransparency = 0.5
            if tab.btn:FindFirstChildOfClass("UIStroke") then 
                tab.btn:FindFirstChildOfClass("UIStroke").Transparency = 0.6 
            end 
        end
        sc.Visible = true
        tBtn.BackgroundTransparency = 0.1
        btnStroke.Transparency = 0.1
    end)
    table.insert(_G.GubbyUI.Tabs, {btn = tBtn, sc = sc, name = tabName})
    if #_G.GubbyUI.Tabs == 1 then 
        sc.Visible = true
        tBtn.BackgroundTransparency = 0.1
        btnStroke.Transparency = 0.1 
    end
    return sc
end

