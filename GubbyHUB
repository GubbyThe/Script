local Config = _G.GeminiConfig
local LP = game:GetService("Players").LocalPlayer
local W = game:GetService("Workspace")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")

local fBP, fBG
local spinAngle = 0

RS.Heartbeat:Connect(function()
    local char = LP.Character; local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = Config.HumanoidMods.Speed end
    
    -- Исправленная плавная левитация Fly без дерганий серверной гравитации
    if Config.Fly.Enabled then
        local cam = W.CurrentCamera
        pcall(function()
            if not fBP then W.Gravity = 0; fBP = Instance.new("BodyPosition", root); fBP.MaxForce = Vector3.new(math.huge, math.huge, math.huge); fBP.Position = root.Position; fBG = Instance.new("BodyGyro", root); fBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge); fBG.CFrame = root.CFrame end
            local m = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then m = m + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then m = m - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then m = m - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then m = m + cam.CFrame.RightVector end
            fBP.Position = fBP.Position + (m * (Config.Fly.Speed / 50)); fBG.CFrame = cam.CFrame
        end)
    else
        if fBP then pcall(function() fBP:Destroy() end) fBP = nil end
        if fBG then pcall(function() fBG:Destroy() end) fBG = nil end
        if W.Gravity == 0 then W.Gravity = Config.HumanoidMods.Gravity end
    end

    -- ЖЕСТКИЙ ФИКС СПИНБОТА: Вращает CFrame. Персонаж крутится ДАЖЕ при ходьбе и беге!
    if Config.Spinbot.Enabled then
        spinAngle = (spinAngle + math.rad(Config.Spinbot.Speed)) % (math.pi * 2)
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, spinAngle, 0)
    end

    -- Умное Wallhop-отталкивание при соприкосновении со стенами перед лицом
    if Config.Wallhop.Enabled and hum and hum.MoveDirection.Magnitude > 0 then
        local ray = Ray.new(root.Position, root.CFrame.LookVector * 2.5)
        local part = W:FindPartOnRay(ray, char)
        if part then root.Velocity = Vector3.new(root.Velocity.X, Config.HumanoidMods.Jump * 0.8, root.Velocity.Z) end
    end

    -- Хитбоксы (KFC Mod)
    if Config.MM2.KFC then
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                hrp.Size = Vector3.new(Config.MM2.KfcSize, Config.MM2.KfcSize, Config.MM2.KfcSize)
                hrp.Transparency = 0.7; hrp.CanCollide = false
            end
        end
    end
end)

