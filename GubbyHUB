}
local Config = _G.GeminiConfig

local flyPosition, flyGyro

-- Находим вкладку "Игрок"
local tabPlayerSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do if t.name == "Игрок" then tabPlayerSc = t.sc break end end
end

if tabPlayerSc then
    -- Моментально сносим старую версию кнопки полёта, чтобы не было раздвоения
    if tabPlayerSc:FindFirstChild("GubbyFlyButton") then tabPlayerSc.GubbyFlyButton:Destroy() end

    -- СОЗДАЕМ ОБНОВЛЕННУЮ КНОПКУ КЛАССИЧЕСКОГО ФЛАЯ
    local FlyBtn = Instance.new("TextButton", tabPlayerSc)
    FlyBtn.Name = "GubbyFlyButton"
    FlyBtn.Size = UDim2.new(1, -10, 0, 32)
    FlyBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    FlyBtn.BackgroundTransparency = 0.5
    FlyBtn.Text = "✈️ Включить R6 Fly Mode (Полёт)"
    FlyBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    FlyBtn.Font = Enum.Font.SourceSansBold
    FlyBtn.TextScaled = true
    Instance.new("UICorner", FlyBtn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", FlyBtn)
    btnStroke.Color = Color3.fromRGB(255, 105, 180)
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    FlyBtn.MouseButton1Click:Connect(function()
        Config.GubbyFly.Enabled = not Config.GubbyFly.Enabled
        if Config.GubbyFly.Enabled then
            FlyBtn.BackgroundTransparency = 0.1
            btnStroke.Transparency = 0.1
            FlyBtn.TextColor3 = Color3.fromRGB(255, 105, 180)
            if W.Gravity ~= 0 then Config.GubbyFly.OriginalGravity = W.Gravity end
        else
            FlyBtn.BackgroundTransparency = 0.5
            btnStroke.Transparency = 0.5
            FlyBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
            if flyPosition then flyPosition:Destroy() flyPosition = nil end
            if flyGyro then flyGyro:Destroy() flyGyro = nil end
            W.Gravity = Config.GubbyFly.OriginalGravity or 196.2
        end
    end)

    -- Перезаписываем стоп-флаг под новый поток
    local r6FlyActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        r6FlyActive = false
        if oldKill then oldKill() end
    end

    task.spawn(function()
        while r6FlyActive do
            RS.Heartbeat:Wait()
            if not r6FlyActive then break end

            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if Config.GubbyFly.Enabled and root then
                local cam = W.CurrentCamera
                pcall(function()
                    if not flyPosition then
                        W.Gravity = 0
                        
                        flyPosition = Instance.new("BodyPosition", root)
                        flyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        flyPosition.Position = root.Position
                        
                        flyGyro = Instance.new("BodyGyro", root)
                        flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        -- Удерживаем персонажа ровно по вертикали, чтобы его не наклоняло
                        flyGyro.CFrame = CFrame.new(root.Position, root.Position + cam.CFrame.LookVector * Vector3.new(1, 0, 1))
                    end

                    -- Считываем горизонтальные кнопки (W, A, S, D) относительно взгляда
                    local lookVec = cam.CFrame.LookVector * Vector3.new(1, 0, 1)
                    local rightVec = cam.CFrame.RightVector * Vector3.new(1, 0, 1)
                    local moveDirection = Vector3.zero

                    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + lookVec end
                    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - lookVec end
                    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - rightVec end
                    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + rightVec end

                    -- Нормализуем горизонтальное движение
                    if moveDirection.Magnitude > 0 then
                        moveDirection = moveDirection.Unit
                    end

                    -- ТВОЯ ИДЕЯ: Пробел — вверх (Y + 1), Левый Контрл — вниз (Y - 1)
                    if UIS:IsKeyDown(Enum.KeyCode.Space) then 
                        moveDirection = moveDirection + Vector3.new(0, 1, 0) 
                    end
                    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then 
                        moveDirection = moveDirection + Vector3.new(0, -1, 0) 
                    end

                    -- Двигаем позицию удержания
                    flyPosition.Position = flyPosition.Position + (moveDirection * (Config.GubbyFly.Speed / 60))
                    
                    -- Позволяет персонажу поворачиваться корпусом туда, куда смотрит камера
                    if lookVec.Magnitude > 0 then
                        flyGyro.CFrame = CFrame.new(root.Position, root.Position + lookVec)
                    end
                end)
            else
                if flyPosition then flyPosition:Destroy() flyPosition = nil end
                if flyGyro then flyGyro:Destroy() flyGyro = nil end
            end
        end
        if flyPosition then flyPosition:Destroy() flyPosition = nil end
        if flyGyro then flyGyro:Destroy() flyGyro = nil end
        W.Gravity = Config.GubbyFly.OriginalGravity or 196.2
    end)

    print("[Gubby Модуль]: Классический R6-флай успешно перезаписан!")
end
