task.spawn(function()
    while ScreenGui and ScreenGui.Parent do
        local deltaTime = RunService.Heartbeat:Wait()
        
        if farmActive and not isFlinging and not isEscaping then
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and hum and hum.Health > 0 then
                local targetEggObj = nil
                local targetPart = nil
                local minDistance = math.huge
                
                -- Ищем все EasterEggReward от зайца и мимиков (без проверки Transparency!)
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "EasterEggReward" and not isInvalidTarget(obj) then
                        local part = getEggPart(obj)
                        if part then
                            local dist = (part.Position - root.Position).Magnitude
                            if dist < minDistance then
                                minDistance = dist
                                targetEggObj = obj
                                targetPart = part
                            end
                        end
                    end
                end
                
                if targetPart and hum.Health > 0 then
                    StatusLabel.Text = "🐰 Лечу к яйцу от пета (" .. math.floor(minDistance) .. "м)..."
                    StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
                    
                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        
                        local targetPos = targetPart.Position
                        local direction = (targetPos - root.Position)
                        local distance = direction.Magnitude
                        
                        if distance > 2.0 then
                            local speed = 40
                            local step = direction.Unit * (speed * deltaTime)
                            
                            if step.Magnitude > distance then
                                root.CFrame = CFrame.new(targetPos)
                            else
                                root.CFrame = root.CFrame + step
                            end
                        else
                            -- Встаём прямо в яйцо и прожимаем все возможные триггеры подбора
                            root.CFrame = CFrame.new(targetPos)
                            collectEgg(targetEggObj, root)
                            task.wait(0.1)
                        end
                    end)
                else
                    root.AssemblyLinearVelocity = Vector3.zero
                    StatusLabel.Text = "🐰 Жду спавн яиц от Easter Bunny / Mimic..."
                    StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 100)
                end
            end
        end
    end
end)

-- ================= 5. SMART MURDERER AVOID (ТОЛЬКО ДЛЯ MM2) =================
addConn(RunService.Heartbeat:Connect(function(dt)
    if isFlinging or not farmActive then
        isEscaping = false
        return
    end
    
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then
        isEscaping = false
        return
    end

    local dangerMurdererRoot = nil
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local enemyChar = player.Character
            local hasKnife = enemyChar:FindFirstChild("Knife") or (player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Knife"))
            if hasKnife then
                local enemyRoot = enemyChar.HumanoidRootPart
                if (enemyRoot.Position - root.Position).Magnitude < 25 then
                    dangerMurdererRoot = enemyRoot
                    break
                end
            end
        end
    end

    if dangerMurdererRoot then
        isEscaping = true
        StatusLabel.Text = "⚠️ УГРОЗА: Мардер рядом! Сбегаю..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            local flatDiff = Vector3.new(root.Position.X - dangerMurdererRoot.Position.X, 0, root.Position.Z - dangerMurdererRoot.Position.Z)
            if flatDiff.Magnitude > 0.1 then
                root.CFrame = root.CFrame + (flatDiff.Unit * (22 * dt))
            end
        end)
    else
        isEscaping = false
    end
end))

