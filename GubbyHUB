if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do
        if t.name == "Кнопки" then tabButtonsSc = t.sc break end
    end
end

if tabButtonsSc then
    -- Зачищаем старые кнопки кликера, если они зависли в памяти
    if tabButtonsSc:FindFirstChild("GubbyAutoclickerButton") then tabButtonsSc.GubbyAutoclickerButton:Destroy() end

    -- 1. СОЗДАЕМ КНОПКУ АКТИВАЦИИ АВТОКЛИКЕРА
