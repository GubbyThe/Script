            LeftEar.Name = "GubbyLeftEar"
            LeftEar.Size = UDim2.new(0, 9, 0, 22)
            LeftEar.Position = UDim2.new(0, 9, 0, 2)
            LeftEar.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
            Instance.new("UICorner", LeftEar).CornerRadius = UDim.new(0, 4)

            local RightEar = Instance.new("Frame", GubbyContainer)
            RightEar.Name = "GubbyRightEar"
            RightEar.Size = UDim2.new(0, 9, 0, 22)
            RightEar.Position = UDim2.new(0, 27, 0, 2)
            RightEar.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
            Instance.new("UICorner", RightEar).CornerRadius = UDim.new(0, 4)

            -- Детали 4 и 5: Удивленные круглые глаза кролика
            local LeftEye = Instance.new("Frame", Face)
            LeftEye.Size = UDim2.new(0, 7, 0, 7)
            LeftEye.Position = UDim2.new(0, 7, 0, 11)
            LeftEye.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            Instance.new("UICorner", LeftEye).CornerRadius = UDim.new(1, 0)

            local RightEye = Instance.new("Frame", Face)
            RightEye.Size = UDim2.new(0, 7, 0, 7)
            RightEye.Position = UDim2.new(0, 21, 0, 11)
            RightEye.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
            Instance.new("UICorner", RightEye).CornerRadius = UDim.new(1, 0)
        end

        if player.Character then setupCharacter(player.Character) end
        player.CharacterAdded:Connect(setupCharacter)
    end

    -- Запускаем подгрузку для всех текущих и заходящих игроков
    for _, player in ipairs(P:GetPlayers()) do createGubbyTag(player) end
    P.PlayerAdded:Connect(createGubbyTag)

    -- 4. ВЫСОКОСКОРОСТНОЙ СИНХРОННЫЙ ПОТОК ОБНОВЛЕНИЯ РОЛЕЙ И ВИДИМОСТИ КРОЛИКОВ
    RS.Heartbeat:Connect(function()
        for _, player in ipairs(P:GetPlayers()) do
            if player ~= LP and player.Character and player.Character:FindFirstChild("Head") then
                local tag = player.Character.Head:FindFirstChild("GubbyESP_Tag")
                if tag then
                    tag.Enabled = Config.GubbyESP.Enabled
                    if Config.GubbyESP.Enabled then
