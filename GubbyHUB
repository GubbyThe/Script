        _G.GeminiConfig.HumanoidMods.Gravity = 196.2
    end
end
local Config = _G.GeminiConfig

-- Находим контейнер твоей вкладки "Игрок"
local tabPlayerSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do
        if t.name == "Игрок" then tabPlayerSc = t.sc break end
    end
end

if tabPlayerSc then
    -- Начисто зачищаем старые элементы гравитации, если они создавались ранее
    if tabPlayerSc:FindFirstChild("GubbySlider_Gravity") then tabPlayerSc["GubbySlider_Gravity"]:Destroy() end
    if tabPlayerSc:FindFirstChild("GubbyResetGravityButton") then tabPlayerSc.GubbyResetGravityButton:Destroy() end

    -- 1. СТРОИМ НЕОНОВО-РОЗОВЫЙ СЛАЙДЕР ГРАВИТАЦИИ
    local SliderFrame = Instance.new("Frame", tabPlayerSc)
    SliderFrame.Name = "GubbySlider_Gravity"
    SliderFrame.Size = UDim2.new(1, -10, 0, 45)
    SliderFrame.BackgroundTransparency = 1
    
    local Label = Instance.new("TextLabel", SliderFrame)
    Label.Size = UDim2.new(1, 0, 0, 18)
    Label.Text = "Гравитация мира: " .. string.format("%.0f", Config.HumanoidMods.Gravity)
    Label.Font = Enum.Font.SourceSansBold
    Label.TextColor3 = Color3.fromRGB(240, 240, 240)
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1
    
    local SliderBG = Instance.new("Frame", SliderFrame)
    SliderBG.Size = UDim2.new(1, -20, 0, 6)
    SliderBG.Position = UDim2.new(0, 10, 0, 24)
    SliderBG.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
    Instance.new("UICorner", SliderBG).CornerRadius = UDim.new(0, 3)
    
    local SliderFill = Instance.new("Frame", SliderBG)
    -- Диапазон гравитации: от 0 (космос) до 400 (тяжесть)
    local minVal, maxVal = 0, 400
    local startPct = math.clamp(Config.HumanoidMods.Gravity / maxVal, 0, 1)
    
    SliderFill.Size = UDim2.new(startPct, 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(255, 105, 180) -- Твой розовый неон
    Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(0, 3)
    
    local Trigger = Instance.new("TextButton", SliderBG)
    Trigger.Size = UDim2.new(0, 12, 0, 12)
    Trigger.Position = UDim2.new(startPct, -6, 0, -3)
    Trigger.BackgroundColor3 = Color3.fromRGB(245, 245, 245) -- Белый кролик-ползунок
    Trigger.Text = ""
    Instance.new("UICorner", Trigger).CornerRadius = UDim.new(1, 0)
    
    local sliding = false
    local function updateSlider(input)
        local percentage = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
        SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
        Trigger.Position = UDim2.new(percentage, -6, 0, -3)
        
        local calculatedValue = math.floor(minVal + (percentage * (maxVal - minVal)))
        Label.Text = "Гравитация мира: " .. tostring(calculatedValue)
        
        Config.HumanoidMods.Gravity = calculatedValue
        -- Меняем гравитацию, только если выключен полет (чтобы не ломать левитацию флая)
        if not Config.GubbyFly or not Config.GubbyFly.Enabled then
            W.Gravity = calculatedValue
        end
    end
    
    Trigger.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end end)
    UIS.InputChanged:Connect(function(i) if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)

    -- 2. СТРОИМ КНОПКУ МГНОВЕННОГО СБРОСА ГРАВИТАЦИИ ПРЯМО ПОД ПОЛЗУНКОМ
