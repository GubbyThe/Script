    -- Логика переключения кнопки и фиксации координат
    OrbitBtn.MouseButton1Click:Connect(function()
        Config.Fling.Enabled = not Config.Fling.Enabled
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        
        if Config.Fling.Enabled then
            OrbitBtn.BackgroundTransparency = 0.1
            btnStroke.Transparency = 0.1
            OrbitBtn.TextColor3 = Color3.fromRGB(255, 50, 50) -- Агрессивный красный при пуске
            btnStroke.Color = Color3.fromRGB(255, 50, 50)
            
            -- Фиксируем точку старта в оригинальную переменную твоего архива
            if root then Config.Fling.StartCFrame = root.CFrame end
        else
            OrbitBtn.BackgroundTransparency = 0.5
            btnStroke.Transparency = 0.5
            OrbitBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
            btnStroke.Color = Color3.fromRGB(255, 105, 180)
            
            -- ТВОЯ ИДЕЯ: Полное гашение скоростей и мгновенный ТП на точку старта!
            if root then
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                if Config.Fling.StartCFrame then
                    task.wait(0.02)
                    root.CFrame = Config.Fling.StartCFrame
                    Config.Fling.StartCFrame = nil
                end
            end
        end
    end)

    -- 2. ТОТ САМЫЙ ОРИГИНАЛЬНЫЙ ПОТОК КРУЖЕНИЯ ВОКРУГ ЦЕЛИ С АВТО-НАВЕДЕНИЕМ
    local orbitActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        orbitActive = false
        if oldKill then oldKill() end
    end

    local rotAngle = 0
    RS.Heartbeat:Connect(function()
        if not orbitActive or not Config.Fling.Enabled then return end
        
        local char = LP.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        -- Считываем цели, которые ты выделил КРАСНЫМ на правой панели ников
        local targetPlayer = nil
        if _G.GeminiConfig and _G.GeminiConfig.GubbyTroll and _G.GeminiConfig.GubbyTroll.Targets then
            for player, isSelected in pairs(_G.GeminiConfig.GubbyTroll.Targets) do
                if isSelected and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")
                    if enemyHum and enemyHum.Health > 0 then
                        targetPlayer = player
                        break
                    end
                end
            end
        end

        -- Если цель выбрана, запускаем оригинальный алгоритм кружения из твоих трофеев
        if targetPlayer then
            local enemyRoot = targetPlayer.Character.HumanoidRootPart
            
            -- Ломаем коллизию своего кролика, чтобы пропеллер сработал сквозь текстуры
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end

            -- Оригинальная математика кружения по радиусу
            rotAngle = (rotAngle + 0.65) % (math.pi * 2)
            local r = Config.Fling.Radius or 2.0
            
            -- Выкручиваем угловую скорость таза по классическому методу твоего чита
            myRoot.Velocity = Vector3.new(450000, 450000, 450000)
            myRoot.RotVelocity = Vector3.new(450000, 450000, 450000)
            
            -- Идеальное наведение на орбиту таза жертвы
            myRoot.CFrame = enemyRoot.CFrame * CFrame.new(math.cos(rotAngle) * r, 0, math.sin(rotAngle) * r)
        else
            -- Если целей нет, держим скорость нулевой
            myRoot.RotVelocity = Vector3.zero
        end
    end)

    print("[Gubby Модуль]: Оригинальный рабочий Orbit Fling успешно вырезан и интегрирован!")
end
