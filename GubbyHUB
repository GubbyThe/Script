-- НАПОЛНЕНИЕ ВКЛАДКИ "КОМБАТ" (ТП К ПИСТОЛЕТУ)
buildGubbyButton("🔫 Телепорт к Пистолету (MM2)", tabCombat, function(btn, stroke)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local gunDrop = W:FindFirstChild("GunDrop", true) or W:FindFirstChild("Luger", true) or W:FindFirstChild("Grip", true)
    
    if gunDrop then
        btn.BackgroundTransparency = 0.1
        stroke.Transparency = 0.1
        btn.TextColor3 = Color3.fromRGB(50, 150, 255)
        stroke.Color = Color3.fromRGB(50, 150, 255)

        pcall(function()
            local targetCFrame = gunDrop:IsA("BasePart") and gunDrop.CFrame or gunDrop.Parent.CFrame
            local oldCFrame = root.CFrame
            root.CFrame = targetCFrame + Vector3.new(0, 1, 0)
            task.wait(0.2)
            root.Velocity = Vector3.zero
            root.CFrame = oldCFrame
        end)

        task.wait(0.5)
        btn.BackgroundTransparency = 0.5
        stroke.Transparency = 0.5
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        stroke.Color = Color3.fromRGB(240, 240, 240)
    else
        btn.TextColor3 = Color3.fromRGB(255, 50, 50)
        btn.Text = "❌ Пистолет не найден на карте!"
        task.wait(1.5)
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        btn.Text = "🔫 Телепорт к Пистолету (MM2)"
    end
end)

-- СИНХРОНИЗАЦИЯ СПИСКА ИГРОКОВ СПРАВА
local function refreshGubbyPlayerList()
    for _, item in ipairs(PlScroll:GetChildren()) do 
        if item:IsA("TextButton") then item:Destroy() end 
    end
    
    local i = 0
    for _, player in ipairs(P:GetPlayers()) do
        if player ~= LP then
            i = i + 1
            local pBtn = Instance.new("TextButton", PlScroll)
            pBtn.Name = "Target_" .. player.Name
            pBtn.Size = UDim2.new(1, -6, 0, 25)
            pBtn.BackgroundTransparency = 0.3
            pBtn.Text = player.Name
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Font = Enum.Font.SourceSansBold
            pBtn.TextSize = 11
            pBtn.TextScaled = true
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            
            local st = Instance.new("UIStroke", pBtn)
            st.Thickness = 1
            st.Transparency = 0.6
            
            local isSel = Config.GubbyTroll.Targets[player]
            pBtn.BackgroundColor3 = isSel and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(40, 40, 45)
            st.Color = isSel and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(240, 240, 240)
            
            pBtn.MouseButton1Click:Connect(function()
                if Config.GubbyTroll.Targets[player] then
                    Config.GubbyTroll.Targets[player] = nil
                    pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
                    st.Color = Color3.fromRGB(240, 240, 240)
                else
                    Config.GubbyTroll.Targets[player] = true
                    pBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                    st.Color = Color3.fromRGB(200, 50, 50)
                end
            end)
        end
    end
    PlScroll.CanvasSize = UDim2.new(0, 0, 0, i * 29)
end

P.PlayerAdded:Connect(refreshGubbyPlayerList)
P.PlayerRemoving:Connect(function(pl) 
    Config.GubbyTroll.Targets[pl] = nil 
    refreshGubbyPlayerList() 
end)
task.spawn(refreshGubbyPlayerList)

