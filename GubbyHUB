-- Функция жесткого хука аниматора через подгрузку чистого кода Roblox
local function injectGubbyAnimate(char)
    -- Уничтожаем старый системный скрипт MM2, который нас блокирует
    local oldAnimate = char:WaitForChild("Animate", 5)
    if oldAnimate then oldAnimate:Destroy() end
    
    -- Скачиваем и запускаем чистый, не заблокированный движком игры скрипт аниматора
    local success, customAnimate = pcall(function()
        return loadstring(game:HttpGet("https://pastebin.com"))()
    end)
    
    if success and customAnimate then
        -- Передаем наши выбранные ID внутрь нового аниматора
        customAnimate:SetPack(_G.CurrentGubbyPack)
    end
end

