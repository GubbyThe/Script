-- Функция создания подсветки на игрока
local function applyESP(player)
    if player == LP then return end
    
    local function createVisuals(char)
        -- Удаляем старый ESP, если он был
        if char:FindFirstChild("GubbyHighlight") then char.GubbyHighlight:Destroy() end
        if char:FindFirstChild("GubbyTag") then char.GubbyTag:Destroy() end
        
        -- 1. Подсветка силуэта (Сияние сквозь стены)
        local highlight = Instance.new("Highlight")
        highlight.Name = "GubbyHighlight"
        highlight.Parent = char
        highlight.FillColor = Color3.fromRGB(255, 105, 180) -- Фирменный розовый Gubby Hub
        highlight.FillTransparency = 0.6
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0.2
        highlight.Adornee = char
        
        -- 2. Никнейм над головой сквозь стены
        local head = char:WaitForChild("Head", 5)
        if head then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "GubbyTag"
            billboard.Parent = char
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 3, 0) -- Высота над головой
            billboard.AlwaysOnTop = true -- Видно сквозь стены!
            
            local textLabel = Instance.new("TextLabel")
            textLabel.Parent = billboard
            textLabel.BackgroundTransparency = 1
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.Text = player.Name
            textLabel.Font = Enum.Font.SourceSansBold
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            textLabel.TextSize = 14
            textLabel.TextStrokeTransparency = 0 -- Черный контур для читаемости
        end
    end
    
    if player.Character then createVisuals(player.Character) end
    player.CharacterAdded:Connect(createVisuals)
end

-- Основной цикл обновления ESP
RS.RenderStepped:Connect(function()
    if not scriptActive then return end
    
    for _, player in ipairs(P:GetPlayers()) do
        local char = player.Character
        if char then
            local highlight = char:FindFirstChild("GubbyHighlight")
            local tag = char:FindFirstChild("GubbyTag")
            
            if Config.GubbyESP.Enabled then
                -- Если ESP включен, но объектов нет — создаем
                if not highlight or not tag then
                    applyESP(player)
                else
                    -- Если объекты есть, просто держим их видимыми
                    highlight.Enabled = true
                    tag.Enabled = true
                end
            else
                -- Если ESP выключен — скрываем объекты
                if highlight then highlight.Enabled = false end
                if tag then tag.Enabled = false end
            end
        end
    end
end)
