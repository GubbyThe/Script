-- Скрипт сразу перезапишет файл на диске под твоим ником!
-- [[ GubbyHUB — ИДЕАЛЬНЫЙ РАЗВОРОТ НА НЕПОДОБРАННЫЕ КОНФЕТЫ (ЧАСТЬ 8) ]] --
local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local username = LocalPlayer.Name
local configFile = "GubbyHub_Broom_" .. username .. ".txt"

-- 1. ФУНКЦИЯ ВЗЛЕТА (Т + 8)
local function activeBroomBySlot()
    task.wait(2.5)
    if isfile and readfile and readfile(configFile) ~= "true" then return end
    
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
    task.wait(0.4)
    
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Eight, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Eight, false, game)
    task.wait(0.5)
    
    local character = LocalPlayer.Character
    if character then
        local broomTool = nil
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if string.find(item.Name, "Broom") then broomTool = item break end
        end
        for _, item in pairs(character:GetChildren()) do
            if string.find(item.Name, "Broom") then broomTool = item break end
        end
        
        if broomTool and broomTool:IsA("Tool") then
            if character:FindFirstChild(broomTool.Name) == nil then
                character:FindFirstChildOfClass("Humanoid"):EquipTool(broomTool)
            end
            task.wait(0.2)
            broomTool:Activate()
        end
    end
    
    task.wait(0.3)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
end

-- 2. УМНЫЙ РАЗВОРОТ ТОЛЬКО НА ЦЕЛЫЕ КОНФЕТЫ
local function startPerfectTracking()
    task.spawn(function()
        while true do
            task.wait(0.05) -- Увеличили частоту до 0.05с для более резкого и точного взгляда
            
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                local bg = rootPart:FindFirstChild("GubbyGyro")
                if not bg then
                    bg = Instance.new("BodyGyro")
                    bg.Name = "GubbyGyro"
                    bg.maxTorque = Vector3.new(0, 400000, 0)
                    bg.P = 15000 -- Чуть прибавили скорости поворота
                    bg.Parent = rootPart
                end
                
                local closestCandy = nil
                local shortestDistance = math.huge
                
                -- Перебираем конфеты на карте
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if (string.find(obj.Name, "Candy") or string.find(obj.Name, "Coin")) and obj:IsA("BasePart") then
                        -- Условие: конфета должна быть ВИДИМОЙ (Transparency меньше 1), значит она еще не подобрана!
                        if obj.Transparency < 0.9 and obj.CanCollide == true then
                            local distance = (rootPart.Position - obj.Position).Magnitude
                            if distance < shortestDistance then
                                shortestDistance = distance
                                closestCandy = obj
                            end
                        end
                    end
                end
                
                -- Направляем взгляд
                if closestCandy then
                    local targetPos = closestCandy.Position
                    bg.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z))
                else
                    bg.CFrame = rootPart.CFrame
                end
            end
        end
    end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    activeBroomBySlot()
end)

if LocalPlayer.Character then activeBroomBySlot() end
startPerfectTracking()
