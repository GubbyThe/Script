-- Бесконечный поток точечного перемещения со скоростью 22
task.spawn(function()
    while true do
        local deltaTime = RS.Heartbeat:Wait()
        
        if farmActive then
            local char = LP.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and hum and hum.Health > 0 then
                -- --- ФУНКЦИЯ АВТО-РЕСЕТА ПРИ ПОЛНОМ МЕШКЕ ---
                pcall(function()
                    local coinValue = LP:FindFirstChild("leaderstats") and LP.leaderstats:FindFirstChild("Coins")
                    local mainGui = LP.PlayerGui:FindFirstChild("MainGui")
                    local gameFrame = mainGui and mainGui:FindFirstChild("Game")
                    local coinLabel = gameFrame and gameFrame:FindFirstChild("CoinLabel") or (gameFrame and gameFrame:FindFirstChild("CoinContainer") and gameFrame.CoinContainer:FindFirstChild("CoinLabel"))
                    
                    local currentCoins = coinValue and coinValue.Value or 0
                    local maxCoins = 40
                    
                    if coinLabel and coinLabel:IsA("TextLabel") and coinLabel.Text:find("/") then
                        local split = coinLabel.Text:split("/")
                        currentCoins = tonumber(split:match("%d+")) or currentCoins
                        maxCoins = tonumber(split:match("%d+")) or maxCoins
                    end
                    
                    if currentCoins >= maxCoins and maxCoins > 0 then
                        Data.StatusLabel.Text = "🚨 Мешок полный ("..currentCoins.."/"..maxCoins..")! Авторесет..."
                        Data.StatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
                        hum.Health = 0
                        task.wait(3)
                    end
                end)

                -- --- ПОИСК БЛИЖАЙШЕЙ МОНЕТЫ ---
                local targetTrigger = nil
                local minDistance = math.huge
                local coinContainer = W:FindFirstChild("CoinContainer", true) or W:FindFirstChild("Coins", true)
                local source = coinContainer or W
                
                for _, obj in ipairs(source:GetDescendants()) do
                    if farmActive and obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
                        local item = obj.Parent
                        if item.Name ~= "Grip" and item.Name ~= "GunDrop" and item.Name ~= "Box" and item.Name ~= "Radio" and not item:FindFirstChildOfClass("Humanoid") then
                            local dist = (item.Position - root.Position).Magnitude
                            -- ФИЛЬТР: Берем только монеты в радиусе доступности, без прыжков сквозь барьеры потолка
                            if math.abs(item.Position.Y - root.Position.Y) < 12 then
                                if dist < minDistance then
                                    minDistance = dist
                                    targetTrigger = item
                                end
                            end
                        end
                    end
                end
                
                -- --- ПЛАВНОЕ CFRAME ПЕРЕМЕЩЕНИЕ СТРОГО НА СКОРОСТИ 22 ---
                if targetTrigger and hum.Health > 0 then
                    Data.StatusLabel.Text = "🎯 Статус: В игре. Собираю валюту..."
                    Data.StatusLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
                    
                    pcall(function()
                        root.Velocity = Vector3.zero -- Намертво обнуляем физический импульс, чтобы не было бешеного разгона
                        root.RotVelocity = Vector3.zero
                        
                        local targetPos = targetTrigger.Position
                        local direction = (targetPos - root.Position)
                        local distance = direction.Magnitude
                        
                        if distance > 1.0 then
                            local speed = 22
                            local step = direction.Unit * (speed * deltaTime)
                            
                            -- Защита: шаг никогда не превысит лимит скорости кадра
                            if step.Magnitude > distance then
                                root.CFrame = CFrame.new(targetPos)
                            else
                                root.CFrame = root.CFrame + step
                            end
                        else
                            task.wait(0.04) -- Стабильная пауза подбора
                        end
                    end)
                else
                    root.Velocity = Vector3.zero
                end
            else
                if root then root.Velocity = Vector3.zero end
                Data.StatusLabel.Text = "💤 Статус: В лобби / Ожидание раунда."
                Data.StatusLabel.TextColor3 = Color3.fromRGB(180, 130, 50)
            end
        end
    end
end)
