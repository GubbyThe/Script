-- Основной цикл обработки
RS.Heartbeat:Connect(function()
    if not scriptActive or (not spushBugActive and not spushCleanActive) or not faceTrollTarget then return end
    
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tChar = faceTrollTarget.Character
    local tHead = tChar and tChar:FindFirstChild("Head")
    
    if myRoot and tHead then
        pcall(function()
            -- Проход сквозь текстуры цели
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            
            if spushBugActive then
                -- РЕЖИМ БАГА (Бешеный таран-молоток по оси Z)
                myRoot.Anchored = false
                local targetPos = tHead.Position + Vector3.new(0, 1.5, 0)
                local waveZ = math.sin(tick() * 45) * 1.2 - 2.2
                myRoot.CFrame = CFrame.lookAt(targetPos, tHead.Position) * CFrame.new(0, 0, waveZ)
                myRoot.Velocity = Vector3.zero
                myRoot.RotVelocity = Vector3.zero
                
            elseif spushCleanActive then
                -- ЧИСТЫЙ РЕЖИМ С АНКОРОМ:
                myRoot.Anchored = true
                
                -- Координаты: нависаем ровно перед лицом цели (Y = 0.3)
                local basePosition = tHead.CFrame * CFrame.new(0, 0.3, -1.5) * CFrame.Angles(0, math.rad(180), 0)
                
                -- Плавное движение вперед-назад
                local motion = math.sin(tick() * 30) * 0.4
                myRoot.CFrame = basePosition * CFrame.new(0, 0, motion)
                
                -- Сброс скоростей
                myRoot.Velocity = Vector3.zero
                myRoot.RotVelocity = Vector3.zero
            end
        end)
    else
        spushBugActive = false
        spushCleanActive = false
        faceTrollTarget = nil
        resetMyCollision()
        if BugBtn then BugBtn.Text = "🚀 Сверхзвуковой Тач-Сэндвич (ФЛИНГ)"; BugBtn.BackgroundTransparency = 0.5 end
        if CleanBtn then CleanBtn.Text = "🥪 Спокойный Сэндвич (Без Флинга)"; CleanBtn.BackgroundTransparency = 0.5 end
    end
end)

