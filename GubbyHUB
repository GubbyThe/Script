local preFlingCFrame = nil
buildGubbyButton("🚀 Включить чистый Fling (По целям)", tabTroll, function(btn, stroke)
    Config.GubbyTroll.Enabled = not Config.GubbyTroll.Enabled
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    
    if Config.GubbyTroll.Enabled then
        btn.BackgroundTransparency = 0.1
        stroke.Transparency = 0.1
        btn.TextColor3 = Color3.fromRGB(255, 50, 50) -- Красный статус атаки
        stroke.Color = Color3.fromRGB(255, 50, 50)
        if root then preFlingCFrame = root.CFrame end
    else
        btn.BackgroundTransparency = 0.5
        stroke.Transparency = 0.5
        btn.TextColor3 = Color3.fromRGB(240, 240, 240)
        stroke.Color = Color3.fromRGB(240, 240, 240)
        
        if root then
            root.Velocity = Vector3.zero
            root.RotVelocity = Vector3.zero
            if preFlingCFrame then
                task.wait(0.02)
                root.CFrame = preFlingCFrame
                preFlingCFrame = nil
            end
        end
    end
end)

-- Высокоскоростной поток направленного тарана (Fling)
RS.Heartbeat:Connect(function()
    if not scriptActive or not Config.GubbyTroll.Enabled then return end
    
    local char = LP.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    local targetPlayer = nil
    for player, isSelected in pairs(Config.GubbyTroll.Targets) do
        if isSelected and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")
            if enemyHum and enemyHum.Health > 0 then
                targetPlayer = player
                break
            end
        end
    end
    
    if targetPlayer then
        local enemyRoot = targetPlayer.Character.HumanoidRootPart
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        
        local safeFrame = myRoot.CFrame
        local powerValue = 650000
        myRoot.Velocity = Vector3.new(powerValue, powerValue, powerValue)
        myRoot.RotVelocity = Vector3.new(powerValue, powerValue, powerValue)
        myRoot.CFrame = enemyRoot.CFrame
        
        RS.Heartbeat:Wait()
        
        myRoot.Velocity = Vector3.zero
        myRoot.RotVelocity = Vector3.zero
        myRoot.CFrame = safeFrame
    else
        myRoot.Velocity = Vector3.zero
    end
end)

