local function removeVisualsForPlayer(p)
    if ActiveVisuals[p] then
        if ActiveVisuals[p].Box then ActiveVisuals[p].Box:Destroy() end
        if ActiveVisuals[p].Line then ActiveVisuals[p].Line:Destroy() end
        if ActiveVisuals[p].Connection then ActiveVisuals[p].Connection:Disconnect() end
        ActiveVisuals[p] = nil
    end
end
local function applyESPAndTracers(p)
    if p == LP then return end
    removeVisualsForPlayer(p)
    local Box = Instance.new("BoxHandleAdornment") Box.AlwaysOnTop = true Box.ZIndex = 5 Box.Color3 = Color3.fromRGB(255, 0, 100) Box.Transparency = 0.5 Box.Size = Vector3.new(4, 5.5, 1.5) Box.Parent = ScreenGui
    local Line = Instance.new("LineHandleAdornment") Line.AlwaysOnTop = true Line.ZIndex = 4 Line.Color3 = Color3.fromRGB(0, 180, 255) Line.Thickness = 2 Line.Parent = ScreenGui
    local conn = RS.RenderStepped:Connect(function()
        local char = p.Character local root = char and char:FindFirstChild("HumanoidRootPart") local myChar = LP.Character local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if root and myRoot and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            Box.Adornee = Config.GubbyESP.Enabled and root or nil
            if Config.GubbyTracers.Enabled then Line.Adornee = root Line.Length = (myRoot.Position - root.Position).Magnitude Line.CFrame = CFrame.lookAt(myRoot.Position, root.Position) else Line.Adornee = nil end
        else Box.Adornee = nil Line.Adornee = nil end
    end)
    ActiveVisuals[p] = {Box = Box, Line = Line, Connection = conn}
end
