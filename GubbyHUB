    if not p.Character then return Color3.fromRGB(0, 255, 0) end
    if p.Character:FindFirstChild("Knife") or p:FindFirstChild("Backpack"):FindFirstChild("Knife") then 
        return Color3.fromRGB(255, 0, 0) -- Убийца
    elseif p.Character:FindFirstChild("Gun") or p:FindFirstChild("Backpack"):FindFirstChild("Gun") then 
