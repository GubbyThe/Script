                        local container = tag:FindFirstChild("GubbyContainer")
                        
                        -- На лету перекрашиваем уши и мордочку кролика под FE-роль
                        if container then
                            if container:FindFirstChild("GubbyFace") then container.GubbyFace.BackgroundColor3 = roleColor end
                            if container:FindFirstChild("GubbyLeftEar") then container.GubbyLeftEar.BackgroundColor3 = roleColor end
                            if container:FindFirstChild("GubbyRightEar") then container.GubbyRightEar.BackgroundColor3 = roleColor end
                        end
                    end
                end
            end
        end
    end)

    print("[Gubby Модуль]: Кастомное Gubby-ESP успешно врезано во вкладку 'Визуалы'!")
