-- ГУББИ ХАБ | МОДУЛЬ-ПРОДОЛЖЕНИЕ: ИСПРАВЛЕННЫЙ РАБОЧИЙ FE FLING ПО НИКНЕЙМАМ
-- ========================================================================
local P = game:GetService("Players")
local RS = game:GetService("RunService")
local LP = P.LocalPlayer

-- Синхронизируем настройки с глобальным конфигом троллинга
_G.GeminiConfig.GubbyTroll = _G.GeminiConfig.GubbyTroll or {Enabled = false, Targets = {}}
local Config = _G.GeminiConfig

-- Находим контейнер твоей вкладки "Троллинг"
local tabTrollSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do if t.name == "Троллинг" then tabTrollSc = t.sc break end end
end

if tabTrollSc then
    -- Начисто сносим любые старые кнопки флингов или заглушки из этой вкладки
    if tabTrollSc:FindFirstChild("GubbySoonTrollLabel") then tabTrollSc.GubbySoonTrollLabel:Destroy() end
    if tabTrollSc:FindFirstChild("GubbyCleanFlingButton") then tabTrollSc.GubbyCleanFlingButton:Destroy() end
    if tabTrollSc:FindFirstChild("GubbyOrbitFlingButton") then tabTrollSc.GubbyOrbitFlingButton:Destroy() end

    -- 1. СОЗДАЕМ КНОПКУ АКТИВАЦИИ РАБОЧЕГО ФЛИНГА
    local FlingBtn = Instance.new("TextButton", tabTrollSc)
    FlingBtn.Name = "GubbyCleanFlingButton"
    FlingBtn.Size = UDim2.new(1, -10, 0, 32)
    FlingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    FlingBtn.BackgroundTransparency = 0.5
    FlingBtn.Text = "🚀 Включить чистый Fling (По целям)"
    FlingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    FlingBtn.Font = Enum.Font.SourceSansBold
    FlingBtn.TextScaled = true -- Защита от выползания текста!
    Instance.new("UICorner", FlingBtn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", FlingBtn)
    btnStroke.Color = Color3.fromRGB(255, 105, 180) -- Твой розовый неон
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    -- Логика переключателя кнопки
    local preFlingCFrame = nil
    FlingBtn.MouseButton1Click:Connect(function()
        Config.GubbyTroll.Enabled = not Config.GubbyTroll.Enabled
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        
        if Config.GubbyTroll.Enabled then
            FlingBtn.BackgroundTransparency = 0.1
            btnStroke.Transparency = 0.1
            FlingBtn.TextColor3 = Color3.fromRGB(255, 50, 50) -- Загорается грозным красным цветом при атаке
            btnStroke.Color = Color3.fromRGB(255, 50, 50)
            if root then preFlingCFrame = root.CFrame end
        else
            FlingBtn.BackgroundTransparency = 0.5
            btnStroke.Transparency = 0.5
            FlingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
            btnStroke.Color = Color3.fromRGB(255, 105, 180)
            
            -- Возврат в безопасность и моментальное гашение скоростей
            if root then
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                if preFlingCFrame then
                    task.wait(0.02)
                    root.CFrame = preFlingCFrame
                    preFlingCFrame = nil
                end
            end
        end
    end)

    -- 2. ВЫСОКОСКОРОСТНОЙ СЕТЕВОЙ ПОТОК РАЗНОСА С ЗАЩИТОЙ КРОЛИКА ПРИ ПЕРЕЗАПУСКЕ
    local flingActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        flingActive = false
        if oldKill then oldKill() end
    end

    RS.Heartbeat:Connect(function()
        if not flingActive then return end
        
        local char = LP.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        if Config.GubbyTroll.Enabled then
            -- Ищем активную выделенную красным цель на правой панели ников
            local targetPlayer = nil
            for player, isSelected in pairs(Config.GubbyTroll.Targets) do
                if isSelected and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")
                    if enemyHum and enemyHum.Health > 0 then
                        targetPlayer = player
                        break
                    end
                end
            end

            -- Если цель на панели активна — подрубаем сетевой таран и ломаем её физику
            if targetPlayer then
                local enemyRoot = targetPlayer.Character.HumanoidRootPart
                
                -- Отключаем коллизию своего тела, чтобы насквозь влететь в хитбокс жертвы
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end

                -- Сохраняем твои координаты на этот микро-тик, чтобы тебя не унесло отдачей
                local safeFrame = myRoot.CFrame

                -- ВЫКРУЧИВАЕМ СЕТЕВОЙ ИМПУЛЬС (Это ломает коллизию цели на уровне движка Roblox)
                local powerValue = 500000
                myRoot.Velocity = Vector3.new(powerValue, powerValue, powerValue)
                myRoot.RotVelocity = Vector3.new(powerValue, powerValue, powerValue)
                
                -- Мгновенно залетаем прямо ВНУТРЬ торса жертвы. Её пулей вышвырнет с сервера!
                myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 0)
                
                -- Даём импульсу сработать ровно один физический тик
                RS.Heartbeat:Wait()
                
                -- МГНОВЕННО возвращаем твоего кролика обратно, гася рикошет
                myRoot.Velocity = Vector3.zero
                myRoot.RotVelocity = Vector3.zero
                myRoot.CFrame = safeFrame
            else
                -- Если целей нет, держим скорость нулевой
                myRoot.Velocity = Vector3.zero
            end
        end
    end)

    print("[Gubby Модуль]: Исправленный направленный флинг успешно добавлен!")
end
