            Face.Name = "GubbyFace"
            Face.Size = UDim2.new(0, 35, 0, 35)
            Face.Position = UDim2.new(0, 5, 0, 20)
            Face.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
            Instance.new("UICorner", Face).CornerRadius = UDim.new(1, 0)

            -- Детали 2 и 3: Ушки
