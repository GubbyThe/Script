-- ГУББИ ХАБ | МОДУЛЬ-ПРОДОЛЖЕНИЕ: СВЕРХБЫСТРЫЙ АВТОКЛИКЕР ДЛЯ ВКЛАДКИ "КНОПКИ"
-- ========================================================================
local P = game:GetService("Players")
local RS = game:GetService("RunService")
