-- РАБОЧИЕ СИСТЕМНЫЕ ЦИКЛЫ
RS.Stepped:Connect(function() 
    if not scriptActive then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart") 
    if hum and root then 
        if not Config.GubbyFly.Enabled then hum.WalkSpeed = Config.PlayerMods.Speed hum.JumpPower = Config.PlayerMods.Jump end
        if Config.GubbyNoclip.Enabled then for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end end
        if Config.GubbyFly.Enabled then 
            hum.PlatformStand = true
            local moveDir = hum.MoveDirection
            local cameraCFrame = Cam.CFrame
            local flyVelocity = Vector3.zero
            if moveDir.Magnitude > 0 then flyVelocity = cameraCFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z).Unit * Config.GubbyFly.Speed) end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then flyVelocity = flyVelocity + Vector3.new(0, Config.GubbyFly.Speed, 0) elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) then flyVelocity = flyVelocity - Vector3.new(0, Config.GubbyFly.Speed, 0) end
            root.Velocity = flyVelocity 
        else 
            if hum.PlatformStand then hum.PlatformStand = false end 
        end 
    end 
end)

UIS.JumpRequest:Connect(function() if scriptActive and Config.InfJump.Enabled and LP.Character then local hum = LP.Character:FindFirstChildOfClass("Humanoid") if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end end end)

UIS.InputBegan:Connect(function(input, gpe)
    if not scriptActive then return end
    if Config.GubbyUIBind.Listening and input.UserInputType == Enum.UserInputType.Keyboard then if input.KeyCode ~= Enum.KeyCode.Escape then Config.GubbyUIBind.Key = input.KeyCode BindBtn.Text = "⌨️ Бинд меню: " .. input.KeyCode.Name end Config.GubbyUIBind.Listening = false BindBtn.BackgroundTransparency = 0.5 bndStr.Transparency = 0.5 return end
    if gpe then return end
    if input.KeyCode == Config.GubbyUIBind.Key then MainFrame.Visible = not MainFrame.Visible UIStroke.Enabled = MainFrame.Visible end
    if Config.ClickTp.Enabled and input.UserInputType == Enum.UserInputType.MouseButton1 and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") local mousePos = UIS:GetMouseLocation() local ray = Cam:ViewportPointToRay(mousePos.X, mousePos.Y) local res = W:Raycast(ray.Origin, ray.Direction * 1000) if root and res then root.CFrame = CFrame.new(res.Position + Vector3.new(0, 3, 0)) root.Velocity = Vector3.zero end end
end)

-- ИСПРАВЛЕНО: Логика списка игроков справа восстановлена в полном объеме
local function refreshGubbyPlayerList()
    for _, item in ipairs(PlScroll:GetChildren()) do if item:IsA("TextButton") then item:Destroy() end end
    local i = 0
    for _, player in ipairs(P:GetPlayers()) do 
        if player ~= LP then 
            i = i + 1
            local pBtn = Instance.new("TextButton", PlScroll)
            pBtn.Name = "Target_" .. player.Name
            pBtn.Size = UDim2.new(1, -6, 0, 25)
            pBtn.BackgroundTransparency = 0.3
            pBtn.Text = player.Name
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Font = Enum.Font.SourceSansBold
            pBtn.TextSize = 11
            pBtn.TextScaled = true
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4) 
            local st = Instance.new("UIStroke", pBtn)
            st.Thickness = 1
            st.Transparency = 0.6
            local isSel = Config.Fling.Targets[player]
            pBtn.BackgroundColor3 = isSel and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(40, 40, 45)
            st.Color = isSel and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(240, 240, 240) 
            pBtn.MouseButton1Click:Connect(function() if Config.Fling.Targets[player] then Config.Fling.Targets[player] = nil pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45) st.Color = Color3.fromRGB(240, 240, 240) else Config.Fling.Targets[player] = true pBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50) st.Color = Color3.fromRGB(200, 50, 50) end end) 
        end 
    end 
    PlScroll.CanvasSize = UDim2.new(0, 0, 0, i * 29)
end

P.PlayerAdded:Connect(refreshGubbyPlayerList)
P.PlayerRemoving:Connect(function(pl) Config.Fling.Targets[pl] = nil refreshGubbyPlayerList() end)
task.spawn(refreshGubbyPlayerList)

print("Gubby HUB V4 успешно запущен!")
