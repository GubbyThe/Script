-- ГУББИ ХАБ | МОДУЛЬ-ПРОДОЛЖЕНИЕ: СИНХРОНИЗАЦИЯ НИКНЕЙМОВ В PLAYER LIST (ВКЛАДКА "ТРОЛЛИНГ")
-- ========================================================================
local P = game:GetService("Players")
local LP = P.LocalPlayer

-- Безопасно инициализируем таблицу целей в твоей базе ReditConfig
if not _G.ReditConfig.GubbyTroll then _G.ReditConfig.GubbyTroll = {Enabled = false, Targets = {}} end
_G.ReditConfig.GubbyTroll.Targets = _G.ReditConfig.GubbyTroll.Targets or {}
local Config = _G.ReditConfig

-- Жесткий поиск твоего оригинального скролл-контейнера для ников
local plScroll = nil
if _G.GeminiUI and _G.GeminiUI.PlScroll then
    plScroll = _G.GeminiUI.PlScroll
elseif _G.ReditUI and _G.ReditUI.ScreenGui then
    local main = _G.ReditUI.ScreenGui:FindFirstChild("MainFrame")
    local plFrame = main and main:FindFirstChild("PlayerListFrame")
    plScroll = plFrame and plFrame:FindFirstChildOfClass("ScrollingFrame")
end

if plScroll then
    local activePlayerButtons = {}

    -- ГЛАВНАЯ ФУНКЦИЯ ОБНОВЛЕНИЯ ВСЕГО СПИСКА ИГРОКОВ НА ЭКРАНЕ
    local function refreshGubbyPlayerList()
        -- Начисто зачищаем старые зависшие кнопки, чтобы не забивать PlayerGui дубликатами
        for _, btn in pairs(activePlayerButtons) do
            if btn and btn.Parent then pcall(function() btn:Destroy() end) end
        end
        table.clear(activePlayerButtons)

        local playerIndex = 0
        local listLayout = plScroll:FindFirstChildOfClass("UIListLayout")
        if listLayout then listLayout.Padding = UDim.new(0, 4) end

        -- Перебираем всех людей на сервере
        for _, player in ipairs(P:GetPlayers()) do
            -- Твое собственное имя в списке не нужно, мы его пропускаем
            if player ~= LP then
                playerIndex = playerIndex + 1

                -- Создаем аккуратную хакерскую кнопочку под цвет шерсти кролика
                local pBtn = Instance.new("TextButton", plScroll)
                pBtn.Name = "UserTarget_" .. player.Name
                pBtn.Size = UDim2.new(1, -6, 0, 25)
                
                -- Если игрок уже был выбран как цель ранее, подсвечиваем его красным, иначе — тёмно-серым
                local isSelected = Config.GubbyTroll.Targets[player]
                pBtn.BackgroundColor3 = isSelected and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(40, 40, 45)
                pBtn.BackgroundTransparency = 0.3
                
                pBtn.Text = player.Name
                pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                pBtn.Font = Enum.Font.SourceSansBold
                pBtn.TextSize = 11
                pBtn.TextScaled = true -- Защита длинных никнеймов от выползания!
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)

                -- Тонкий розовый контур вокруг каждого ника для общего стиля
                local btnStroke = Instance.new("UIStroke", pBtn)
                btnStroke.Color = isSelected and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(255, 105, 180)
                btnStroke.Thickness = 1
                btnStroke.Transparency = 0.6

                -- ЛОГИКА ВЫДЕЛЕНИЯ ЦЕЛИ (ЛКМ КЛИК)
                pBtn.MouseButton1Click:Connect(function()
                    if Config.GubbyTroll.Targets[player] then
                        -- Снимаем выделение: возвращаем серый цвет
                        Config.GubbyTroll.Targets[player] = nil
                        pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
                        btnStroke.Color = Color3.fromRGB(255, 105, 180)
                    else
                        -- Активируем цель: подсвечиваем грозным красным цветом атаки
                        Config.GubbyTroll.Targets[player] = true
                        pBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                        btnStroke.Color = Color3.fromRGB(200, 50, 50)
                    end
                end)

                table.insert(activePlayerButtons, pBtn)
            end
        end

        -- Динамически рассчитываем высоту зоны скролла под количество кнопок, чтобы список не обрезался
        plScroll.CanvasSize = UDim2.new(0, 0, 0, playerIndex * 29)
    end

    -- ПРИВЯЗКА СОБЫТИЙ: Моментально реагируем на заход и выход людей
    local joinConn = P.PlayerAdded:Connect(refreshGubbyPlayerList)
    local leaveConn = P.PlayerRemoving:Connect(function(player)
        Config.GubbyTroll.Targets[player] = nil -- Безопасно стираем цель из памяти, если чел ливнул
        refreshGubbyPlayerList()
    end)

    -- Настраиваем стоп-флаг под нашу общую функцию очистки памяти при ре-инжекте
    local listSyncActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        listSyncActive = false
        if joinConn then joinConn:Disconnect() end
        if leaveConn then leaveConn:Disconnect() end
        if oldKill then oldKill() end
    end

    -- Первый принудительный запуск сканирования сервера при старте
    task.spawn(refreshGubbyPlayerList)

    print("[Gubby Модуль]: Правая панель списка ников успешно синхронизирована с базой целей!")
else
    print("[Gubby Ошибка]: Не удалось обнаружить пустое правое окошко под ники!")
end
-- ========================================================================
-- ГУББИ ХАБ | МОДУЛЬ-ПРОДОЛЖЕНИЕ: ЧИСТЫЙ НАПРАВЛЕННЫЙ ФЛИНГ (ВКЛАДКА "ТРОЛЛИНГ")
-- ========================================================================
local P = game:GetService("Players")
local RS = game:GetService("RunService")
local LP = P.LocalPlayer

-- Подтягиваем базу настроек троллинга
_G.GeminiConfig.GubbyTroll = _G.GeminiConfig.GubbyTroll or {Enabled = false, Targets = {}}
local Config = _G.GeminiConfig

-- Находим контейнер твоей вкладки "Троллинг"
local tabTrollSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do
        if t.name == "Троллинг" then tabTrollSc = t.sc break end
    end
end

if tabTrollSc then
    -- Зачищаем старые кнопки флинга, если они зависли в памяти Solara V3
    if tabTrollSc:FindFirstChild("GubbyCleanFlingButton") then tabTrollSc.GubbyCleanFlingButton:Destroy() end

    -- 1. СОЗДАЕМ КНОПКУ АКТИВАЦИИ ЧИСТОГО ФЛИГНА
    local FlingBtn = Instance.new("TextButton", tabTrollSc)
    FlingBtn.Name = "GubbyCleanFlingButton"
    FlingBtn.Size = UDim2.new(1, -10, 0, 32)
    FlingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    FlingBtn.BackgroundTransparency = 0.5
    FlingBtn.Text = "🚀 Включить чистый Fling (По целям)"
    FlingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    FlingBtn.Font = Enum.Font.SourceSansBold
    FlingBtn.TextScaled = true -- Полная защита от выползания текста!
    Instance.new("UICorner", FlingBtn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", FlingBtn)
    btnStroke.Color = Color3.fromRGB(255, 105, 180) -- Твой розовый неон
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    -- Логика переключения кнопки атаки
    local savedPositionBeforeAttack = nil
    FlingBtn.MouseButton1Click:Connect(function()
        Config.GubbyTroll.Enabled = not Config.GubbyTroll.Enabled
        
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if Config.GubbyTroll.Enabled then
            FlingBtn.BackgroundTransparency = 0.1
            btnStroke.Transparency = 0.1
            FlingBtn.TextColor3 = Color3.fromRGB(255, 50, 50) -- Загорается агрессивным красным при атаке
            btnStroke.Color = Color3.fromRGB(255, 50, 50)
            
            -- Запоминаем твои координаты до атаки, чтобы вернуть обратно в безопасность
            if root then savedPositionBeforeAttack = root.CFrame end
        else
            FlingBtn.BackgroundTransparency = 0.5
            btnStroke.Transparency = 0.5
            FlingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
            btnStroke.Color = Color3.fromRGB(255, 105, 180)
            
            -- Мгновенно возвращаем тебя назад и полностью тушим скорость таза
            if root and savedPositionBeforeAttack then
                task.wait(0.04)
                root.CFrame = savedPositionBeforeAttack
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
                savedPositionBeforeAttack = nil
            end
        end
    end)

    -- 2. ВЫСОКОСКОРОСТНОЙ ПОТОК ЖЕСТКОЙ ТЕЛЕПОРТ-АТАКИ ПО НИКНЕЙМАМ ИЗ СПИСКА
    local flingActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        flingActive = false -- Мгновенно глушим поток при перезапуске хаба, спасая память Solara V3
        if oldKill then oldKill() end
    end

    RS.Heartbeat:Connect(function()
        if not flingActive or not Config.GubbyTroll.Enabled then return end
        
        local char = LP.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        
        -- Проверяем, выбран ли кто-то прямо сейчас на правой панели целей
        local currentTargetPlayer = nil
        for player, isSelected in pairs(Config.GubbyTroll.Targets) do
            if isSelected and player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")
                -- Атакуем только живых игроков
                if enemyHum and enemyHum.Health > 0 then
                    currentTargetPlayer = player
                    break
                end
            end
        end
        
        -- Если цель из списка найдена и она жива — запускаем протокол аннигиляции физики
        if currentTargetPlayer then
            local enemyRoot = currentTargetPlayer.Character.HumanoidRootPart
            
            -- Отключаем коллизии своих конечностей, чтобы не спотыкаться о жертву
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            
            -- АНТИ-РИКОШЕТ: сохраняем твои координаты на этот микро-тик
            local mySecureFrame = myRoot.CFrame
            
            -- Выкручиваем угловое и линейное ускорение таза на сумасшедшие 650 000 единиц!
            local flingPower = 650000
            myRoot.Velocity = Vector3.new(flingPower, flingPower, flingPower)
            myRoot.RotVelocity = Vector3.new(flingPower, flingPower, flingPower)
            
            -- Мгновенно залетаем прямо ВНУТРЬ торса жертвы. Серверный движок Roblox выкинет её за карту!
            myRoot.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, 0)
            
            -- Даём импульсу сработать ровно один физический тик
            RS.Heartbeat:Wait()
            
            -- Стабилизируем твоего кролика, чтобы тебя не унесло следом на Юпитер
            myRoot.Velocity = Vector3.zero
            myRoot.RotVelocity = Vector3.zero
            myRoot.CFrame = mySecureFrame
        else
            -- Если выбранные цели мертвы или их нет, держим скорость стабильной
            if not _G.GeminiConfig.Spinbot or not _G.GeminiConfig.Spinbot.Enabled then
                myRoot.RotVelocity = Vector3.zero
            end
        end
    end)

    print("[Gubby Модуль]: Чистый направленный флинг успешно добавлен во вкладку 'Троллинг'!")
else
    print("[Gubby Ошибка]: Не удалось найти вкладку 'Троллинг'!")
end
