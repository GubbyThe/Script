-- ================= 2. ОБЩИЕ ФИЛЬТРЫ И ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ =================
local LobbyFolder = Workspace:FindFirstChild("Lobby")

local function isInvalidTarget(item)
    if CURRENT_MODE == "GAG" then
        local fullName = item:GetFullName()
        if fullName:find("PetsPhysical") or fullName:find("Shop") or fullName:find("Interaction") then
            return true
        end
    else
        if LobbyFolder and item:IsDescendantOf(LobbyFolder) then
            return true
        end
    end

    local current = item.Parent
    while current and current ~= Workspace do
        if current:FindFirstChildOfClass("Humanoid") then
            return true
        end
        if CURRENT_MODE == "MM2" and (current.Name == "Lobby" or current.Name == "Shop" or current.Name == "NPCs") then
            return true
        end
        current = current.Parent
    end
    return false
end

local function getPartFromObj(obj)
    if obj:IsA("BasePart") then
        return obj
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("BasePart") and d.Position.Magnitude > 1 then
                return d
            end
        end
        return obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function getMM2Container()
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") or child:IsA("Folder") then
            local container = child:FindFirstChild("CoinContainer") or child:FindFirstChild("EggContainer")
            if container then return container end
        end
    end
    return Workspace:FindFirstChild("CoinContainer", true) or Workspace:FindFirstChild("EggContainer", true)
end

-- ================= 3. АВТО-СБРОС МЕШКА (ДЛЯ РЕЖИМА MM2) =================
local resetCooldown = false
local function checkMM2BagFull(hum)
    if CURRENT_MODE ~= "MM2" or resetCooldown then return end
    
    local currentCoins, maxCoins = 0, 40
    local foundBagUI = false

    pcall(function()
        local mainGui = LP.PlayerGui:FindFirstChild("MainGui")
        local gameFrame = mainGui and mainGui:FindFirstChild("Game")
        if gameFrame then
            for _, lbl in ipairs(gameFrame:GetDescendants()) do
                if lbl:IsA("TextLabel") and lbl.Visible and lbl.Text:match("^%s*%d+%s*/%s*%d+%s*$") then
                    local split = lbl.Text:split("/")
                    local cur = tonumber(split:match("%d+"))
                    local max = tonumber(split:match("%d+"))
                    if cur and max and max > 0 then
                        currentCoins, maxCoins, foundBagUI = cur, max, true
                        break
                    end
                end
            end
        end
    end)

    if foundBagUI and currentCoins >= maxCoins then
        resetCooldown = true
        StatusLabel.Text = "🚨 Мешок полный (" .. currentCoins .. "/" .. maxCoins .. ")! Авторесет..."
        StatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
        hum.Health = 0
        task.delay(4, function() resetCooldown = false end)
    end
end

