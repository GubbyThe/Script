-- Подтягиваем базу настроек троллинга
_G.GeminiConfig.GubbyTroll = _G.GeminiConfig.GubbyTroll or {Enabled = false, Targets = {}}
local Config = _G.GeminiConfig

-- Находим контейнер твоей вкладки "Троллинг"
local tabTrollSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do if t.name == "Троллинг" then tabTrollSc = t.sc break end end
end

if tabTrollSc then
    -- Начисто сносим старые нерабочие кнопки флингов или спинботов
    if tabTrollSc:FindFirstChild("GubbyCleanFlingButton") then tabTrollSc.GubbyCleanFlingButton:Destroy() end
    if tabTrollSc:FindFirstChild("GubbyOrbitFlingButton") then tabTrollSc.GubbyOrbitFlingButton:Destroy() end
    if tabTrollSc:FindFirstChild("GubbySpinTaranButton") then tabTrollSc.GubbySpinTaranButton:Destroy() end

    -- 1. СОЗДАЕМ КНОПКУ АКТИВАЦИИ САМОНАВОДЯЩЕГОСЯ ТАРАНА
    local AttackBtn = Instance.new("TextButton", tabTrollSc)
