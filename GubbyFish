                pBtn.Font = Enum.Font.SourceSansBold
                pBtn.TextSize = 12
                pBtn.TextScaled = true
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
                
                local pStroke = Instance.new("UIStroke", pBtn)
                pStroke.Color = Color3.fromRGB(200, 60, 60)
                pStroke.Thickness = 0.8

                -- ТВОЯ ХАКЕРСКАЯ ЛОГИКА ЖЁСТКОЙ ПРИВЯЗКИ (ATTACH ORBIT FLING)
                pBtn.MouseButton1Click:Connect(function()
                    local myChar = LP.Character
                    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
                    local enemyChar = player.Character
                    local enemyRoot = enemyChar and enemyChar:FindFirstChild("HumanoidRootPart")
                    
                    if myRoot and myHum and enemyRoot then
                        pBtn.Text = "💥 ПРИВЯЗКА И НАКРУТКА..."
                        
                        -- Запоминаем изначальную безопасную координату до атаки
                        local oldCFrame = myRoot.CFrame
                        
                        -- Намертво выключаем коллизию своего персонажа, чтобы не улететь самому
                        local steppedConnection = RS.Stepped:Connect(function()
                            for _, part in ipairs(myChar:GetDescendants()) do
                                if part:IsA("BasePart") then part.CanCollide = false end
                            end
                        end)

                        -- Накручиваем огромную скорость анимации ходьбы на уровне гуманоида
                        local originalSpeed = myHum.WalkSpeed
                        myHum.WalkSpeed = 250
                        
                        local angle = 0
                        local attackTime = 0
                        local targetSentToSpace = false
                        
                        -- Цикл жёсткого удержания внутри торса цели
                        while attackTime < 3.0 and not targetSentToSpace do
                            local dt = RS.Heartbeat:Wait()
                            attackTime = attackTime + dt
                            
                            -- Проверяем, существует ли ещё цель и не умерла ли она
                            if not player or not player.Character or not enemyRoot.Parent then break end
                            
                            -- Математика Orbit-привязки: бешено крутимся вокруг его торса с радиусом 0.5 студа
                            angle = angle + 45
                            local offset = Vector3.new(math.sin(angle) * 0.5, 0, math.cos(angle) * 0.5)
                            
                            -- Жёстко выставляем CFrame прямо внутрь челика и крутим угловую скорость таза
                            myRoot.CFrame = CFrame.new(enemyRoot.Position + offset)
                            myRoot.Velocity = Vector3.new(500000, 500000, 500000)
                            myRoot.RotVelocity = Vector3.new(500000, 500000, 500000)
                            
                            -- ТВОЙ ЛАЙФХАК: Проверяем, улетел ли он уже в экзотическое далёко (дистанция больше 70 студов)
                            local currentDist = (enemyRoot.Position - oldCFrame.Position).Magnitude
                            if currentDist > 70 then
                                targetSentToSpace = true
                            end
                        end

                        -- ОТПУСКАЕМ ЦЕЛЬ И ВОЗВРАЩАЕМСЯ НА БАЗУ С ОЧИСТКОЙ СКОРОСТЕЙ
                        if steppedConnection then steppedConnection:Disconnect() end
                        
                        myRoot.Velocity = Vector3.zero
                        myRoot.RotVelocity = Vector3.zero
                        myHum.WalkSpeed = originalSpeed
                        
                        -- Возвращаем в изначальную координату
                        myRoot.CFrame = oldCFrame
                        
                        -- ТВОЯ ИДЕЯ: Даём задержку в 1 секунду на полный сброс скоростей для защиты от античита
                        pBtn.Text = "🛡️ СБРОС СКОРОСТИ (1 сек)..."
                        task.wait(1.0)
                        
                        pBtn.Text = "🚀 Отправить: " .. player.Name
                    end
                end)
                table.insert(activeButtons, pBtn)
            end
        end
    end

    local c1 = P.PlayerAdded:Connect(updateFlingList)
    local c2 = P.PlayerRemoving:Connect(updateFlingList)
    
    Data.ScreenGui.Destroying:Connect(function()
        if c1 then c1:Disconnect() end
        if c2 then c2:Disconnect() end
    end)

    task.spawn(updateFlingList)
    print("[Gubby Модуль]: Новый Orbit-Флинг по твоей тактике успешно загружен!");
end)
