-- Глобальная функция создания вкладки для Части 2
local pages = {}
local firstPage = true

getgenv().GubbyCore.CreateTab = function(tabName)
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(0, 110, 0, 45)
    TabButton.BackgroundColor3 = Color3.fromRGB(180, 183, 188)
    TabButton.Text = tabName
    TabButton.TextColor3 = Color3.fromRGB(60, 60, 65)
    TabButton.Font = Enum.Font.SourceSansBold
    TabButton.TextSize = 15
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 14)
    ButtonCorner.Parent = TabButton
    
    local ButtonStroke = Instance.new("UIStroke")
    ButtonStroke.Color = Color3.fromRGB(160, 162, 165)
    ButtonStroke.Parent = TabButton
    TabButton.Parent = TabScroller
    
    local PageFrame = Instance.new("Frame")
    PageFrame.Size = UDim2.new(1, 0, 1, 0)
    PageFrame.BackgroundTransparency = 1
    PageFrame.Visible = false
    PageFrame.Parent = ContainerScroller
    
    local PageLayout = Instance.new("UIListLayout")
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 10)
    PageLayout.Parent = PageFrame
    
    pages[tabName] = PageFrame
    
    TabButton.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.Visible = false end
        PageFrame.Visible = true
        for _, b in pairs(TabScroller:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(180, 183, 188)
                b.TextColor3 = Color3.fromRGB(60, 60, 65)
                b:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(160, 162, 165)
            end
        end
        TabButton.BackgroundColor3 = Color3.fromRGB(160, 32, 255)
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        ButtonStroke.Color = Color3.fromRGB(200, 100, 255)
    end)
    
    if firstPage then
        PageFrame.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(160, 32, 255)
        TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        ButtonStroke.Color = Color3.fromRGB(200, 100, 255)
        firstPage = false
    end
    
    local function AddEmptyToggle(text)
        local ToggleFrame = Instance.new("Frame")
        ToggleFrame.Size = UDim2.new(1, -10, 0, 55)
        ToggleFrame.BackgroundColor3 = Color3.fromRGB(195, 198, 202)
        
        local TFCorner = Instance.new("UICorner")
        TFCorner.CornerRadius = UDim.new(0, 16)
        TFCorner.Parent = ToggleFrame
        
        local TFStroke = Instance.new("UIStroke")
        TFStroke.Color = Color3.fromRGB(175, 178, 182)
        TFStroke.Parent = ToggleFrame
        
        local ToggleLabel = Instance.new("TextLabel")
        ToggleLabel.Size = UDim2.new(0, 250, 1, 0)
        ToggleLabel.Position = UDim2.new(0, 20, 0, 0)
        ToggleLabel.BackgroundTransparency = 1
        ToggleLabel.Text = text
        ToggleLabel.TextColor3 = Color3.fromRGB(40, 40, 45)
        ToggleLabel.Font = Enum.Font.SourceSansBold
        ToggleLabel.TextSize = 18
        ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left
        ToggleLabel.Parent = ToggleFrame
        
        local SwitchBtn = Instance.new("TextButton")
        SwitchBtn.Size = UDim2.new(0, 45, 0, 22)
        SwitchBtn.Position = UDim2.new(1, -65, 0.5, -11)
        SwitchBtn.BackgroundColor3 = Color3.fromRGB(160, 163, 168)
        SwitchBtn.Text = ""
        
        local SwitchCorner = Instance.new("UICorner")
        SwitchCorner.CornerRadius = UDim.new(0, 11)
        SwitchCorner.Parent = SwitchBtn
        
        local Circle = Instance.new("Frame")
        Circle.Size = UDim2.new(0, 16, 0, 16)
        Circle.Position = UDim2.new(0, 3, 0.5, -8)
        Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        
        local CircleCorner = Instance.new("UICorner")
        CircleCorner.CornerRadius = UDim.new(0, 8)
        CircleCorner.Parent = Circle
        Circle.Parent = SwitchBtn
        SwitchBtn.Parent = ToggleFrame
        ToggleFrame.Parent = PageFrame
        
        local enabled = false
        SwitchBtn.MouseButton1Click:Connect(function()
            enabled = not enabled
            if enabled then
                TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(160, 32, 255)}):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(1, -19, 0.5, -8)}):Play()
            else
                TweenService:Create(SwitchBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(160, 163, 168)}):Play()
                TweenService:Create(Circle, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -8)}):Play()
            end
        end)
    end
    
    return {AddToggle = AddEmptyToggle}
end
