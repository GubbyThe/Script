-- ГУББИ ХАБ | МОДУЛЬ-ПРОДОЛЖЕНИЕ: ОРИГИНАЛЬНЫЙ АНТИ-ФЛИНГ ИЗ ТВОИХ АРХИВОВ
-- ========================================================================
local P = game:GetService("Players")
local RS = game:GetService("RunService")
local LP = P.LocalPlayer

-- Намертво привязываемся к имени переменной из твоего оригинального архива
_G.GeminiConfig.AntiFling = _G.GeminiConfig.AntiFling or {Enabled = false}
local Config = _G.GeminiConfig

-- Находим контейнер твоей вкладки "Троллинг"
local tabTrollSc = nil
if _G.GeminiUI and _G.GeminiUI.Tabs then
    for _, t in pairs(_G.GeminiUI.Tabs) do if t.name == "Троллинг" then tabTrollSc = t.sc break end end
end

if tabTrollSc then
    -- Зачищаем старые кнопки анти-флинга, если они создавались ранее
    if tabTrollSc:FindFirstChild("GubbyAntiFlingButton") then tabTrollSc.GubbyAntiFlingButton:Destroy() end

    -- 1. СОЗДАЕМ КНОПКУ АКТИВАЦИИ АНТИ-ФЛИГНА
    local AntiFlingBtn = Instance.new("TextButton", tabTrollSc)
    AntiFlingBtn.Name = "GubbyAntiFlingButton"
    AntiFlingBtn.Size = UDim2.new(1, -10, 0, 32)
    AntiFlingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    AntiFlingBtn.BackgroundTransparency = 0.5
    AntiFlingBtn.Text = "🛡️ Включить Анти-Флинг Щит"
    AntiFlingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
    AntiFlingBtn.Font = Enum.Font.SourceSansBold
    AntiFlingBtn.TextScaled = true -- Железная защита от выползания текста!
    Instance.new("UICorner", AntiFlingBtn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", AntiFlingBtn)
    btnStroke.Color = Color3.fromRGB(255, 105, 180) -- Твой розовый неон
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    -- Логика переключения кнопки
    AntiFlingBtn.MouseButton1Click:Connect(function()
        Config.AntiFling.Enabled = not Config.AntiFling.Enabled
        
        if Config.AntiFling.Enabled then
            AntiFlingBtn.BackgroundTransparency = 0.1
            btnStroke.Transparency = 0.1
            AntiFlingBtn.TextColor3 = Color3.fromRGB(255, 105, 180)
        else
            AntiFlingBtn.BackgroundTransparency = 0.5
            btnStroke.Transparency = 0.5
            AntiFlingBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
            
            -- При выключении возвращаем нормальную коллизию конечностям
            local char = LP.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end
    end)

    -- 2. ВЫСОКОСКОРОСТНОЙ ПОТОК ЖЕСТКОЙ ДИНАМИЧЕСКОЙ ЗАЩИТЫ ОТ ЧИТЕРОВ
    local antiFlingActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        antiFlingActive = false -- Мгновенно тушим поток при перезапуске хаба, спасая память
        if oldKill then oldKill() end
    end

    RS.Heartbeat:Connect(function()
        if not antiFlingActive or not Config.AntiFling.Enabled then return end

        local char = LP.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        pcall(function()
            -- Проверяем всех игроков на сервере на наличие бешеной скорости
            for _, player in ipairs(P:GetPlayers()) do
                if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    local enemyRoot = player.Character.HumanoidRootPart
                    local enemyHum = player.Character:FindFirstChildOfClass("Humanoid")

                    -- Если чужой читер жив и находится в радиусе 25 студов от нас
                    if enemyHum and enemyHum.Health > 0 and (myRoot.Position - enemyRoot.Position).Magnitude <= 25 then
                        -- И если его скорость или угловое вращение превышает лимиты (он пытается флингануть)
                        if enemyRoot.Velocity.Magnitude > 70 or enemyRoot.RotVelocity.Magnitude > 70 or enemyRoot.AssemblyLinearVelocity.Magnitude > 70 then
                            
                            -- Мгновенно врубаем режим призрака для нашего тела: враг пролетит насквозь!
                            for _, part in ipairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    part.CanCollide = false
                                end
                            end
                            
                            -- Принудительно гасим инерцию нашего таза, чтобы нас не зацепило ударной волной
                            myRoot.Velocity = Vector3.zero
                            myRoot.RotVelocity = Vector3.zero
                        end
                    end
                end
            end
        end)
    end)

    print("[Gubby Модуль]: Тот самый оригинальный Анти-Флинг щит успешно врезан во вкладку 'Троллинг'!")
else
    print("[Gubby Ошибка]: Не удалось найти вкладку 'Троллинг'!")
end
