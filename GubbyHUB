-- РАБОЧИЕ СИСТЕМНЫЕ ЦИКЛЫ КЛАССИЧЕСКОГО ДВИЖЕНИЯ
RS.Stepped:Connect(function()
    if not scriptActive then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if hum and root then
        if not Config.GubbyFly.Enabled then 
            hum.WalkSpeed = Config.PlayerMods.Speed 
            hum.JumpPower = Config.PlayerMods.Jump 
        end
        if Config.GubbyNoclip.Enabled then 
            for _, part in pairs(char:GetDescendants()) do 
                if part:IsA("BasePart") then part.CanCollide = false end 
            end 
        end
        
        -- Стабильный Fly по кнопкам WASD
        if Config.GubbyFly.Enabled then
            local moveDir = hum.MoveDirection
            local flyVelocity = moveDir * Config.GubbyFly.Speed
            
            if UIS:IsKeyDown(Enum.KeyCode.Space) then 
                flyVelocity = flyVelocity + Vector3.new(0, Config.GubbyFly.Speed, 0) 
            elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) then 
                flyVelocity = flyVelocity - Vector3.new(0, Config.GubbyFly.Speed, 0) 
            end
            root.Velocity = Vector3.new(flyVelocity.X, flyVelocity.Y, flyVelocity.Z)
        end
    end
end)

UIS.JumpRequest:Connect(function() 
    if scriptActive and Config.InfJump.Enabled and LP.Character then 
        local hum = LP.Character:FindFirstChildOfClass("Humanoid") 
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end 
    end 
end)

UIS.InputBegan:Connect(function(input, gpe)
    if not scriptActive then return end
    if Config.GubbyUIBind.Listening and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode ~= Enum.KeyCode.Escape then 
            Config.GubbyUIBind.Key = input.KeyCode 
            BindBtn.Text = "⌨️ Бинд меню: " .. input.KeyCode.Name 
        end
        Config.GubbyUIBind.Listening = false 
        BindBtn.BackgroundTransparency = 0.5 
        bndStr.Transparency = 0.5 
        return
    end
    if gpe then return end
    if input.KeyCode == Config.GubbyUIBind.Key then 
        MainFrame.Visible = not MainFrame.Visible 
        UIStroke.Enabled = MainFrame.Visible 
    end
    if Config.ClickTp.Enabled and input.UserInputType == Enum.UserInputType.MouseButton1 and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local mousePos = UIS:GetMouseLocation() 
        local ray = Cam:ViewportPointToRay(mousePos.X, mousePos.Y) 
        local res = W:Raycast(ray.Origin, ray.Direction * 1000)
        if root and res then 
            root.CFrame = CFrame.new(res.Position + Vector3.new(0, 3, 0)) 
            root.Velocity = Vector3.zero 
        end
    end
end)
