local pages = {}
local firstPage = true

getgenv().GubbyCore.CreateTab = function(tabName)
    local TabButton = Instance.new("TextButton")
    TabButton.Size = UDim2.new(0.92, 0, 0, 42)
    TabButton.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    TabButton.Text = tabName
    TabButton.TextColor3 = Color3.fromRGB(150, 150, 155)
    TabButton.Font = Enum.Font.SourceSansBold
    TabButton.TextSize = 14
    
    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 12)
    ButtonCorner.Parent = TabButton
    
    local ButtonStroke = Instance.new("UIStroke")
    ButtonStroke.Color = Color3.fromRGB(55, 55, 60)
    ButtonStroke.Parent = TabButton
    TabButton.Parent = TabScroller
    
    local PageFrame = Instance.new("Frame")
    PageFrame.Size = UDim2.new(1, 0, 1, 0)
    PageFrame.BackgroundTransparency = 1
    PageFrame.Visible = false
    PageFrame.Parent = ContainerScroller
    
    local PageLayout = Instance.new("UIListLayout")
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 14)
    PageLayout.Parent = PageFrame
    
    pages[tabName] = PageFrame
    
    TabButton.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.Visible = false end
        PageFrame.Visible = true
        for _, b in pairs(TabScroller:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
                b.TextColor3 = Color3.fromRGB(150, 150, 155)
                b:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(55, 55, 60)
            end
        end
        TabButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.TextColor3 = Color3.fromRGB(0, 0, 0)
        ButtonStroke.Color = Color3.fromRGB(255, 255, 255)
    end)
    
    if firstPage then
        PageFrame.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        TabButton.TextColor3 = Color3.fromRGB(0, 0, 0)
        ButtonStroke.Color = Color3.fromRGB(255, 255, 255)
        firstPage = false
    end
    
    local function AddTextLabel(title, text)
        local TextBlock = Instance.new("TextLabel")
        TextBlock.Size = UDim2.new(0.94, 0, 0, 0)
        TextBlock.AutomaticSize = Enum.AutomaticSize.Y
        TextBlock.BackgroundTransparency = 1
        TextBlock.Text = "<b>" .. title .. "</b>\n<i>" .. text .. "</i>"
        TextBlock.RichText = true
        TextBlock.TextColor3 = Color3.fromRGB(240, 240, 245)
        TextBlock.Font = Enum.Font.SourceSans
        TextBlock.TextSize = 16
        TextBlock.TextWrapped = true
        TextBlock.TextXAlignment = Enum.TextXAlignment.Left
        TextBlock.TextYAlignment = Enum.TextYAlignment.Top
        
        local Padding = Instance.new("UIPadding")
        Padding.PaddingRight = UDim.new(0, 5)
        Padding.Parent = TextBlock
        
        TextBlock.Parent = PageFrame
    end
    
    return {AddInfo = AddTextLabel}
end
