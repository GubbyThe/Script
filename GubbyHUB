    if G_UI.B_Refs.BypassSpeedBtn then pcall(function() G_UI.B_Refs.BypassSpeedBtn:Destroy() end) end

    -- Создаем аккуратные и чистые кнопки без скобочек
    local CooldownButton = G_UI.CreateButton("Отключить перезарядку", targetScrollFrame, 27)
    local SpeedBypassButton = G_UI.CreateButton("Включить обход скорости", targetScrollFrame, 28)
    
    G_UI.B_Refs.NoCooldownBtn = CooldownButton
    G_UI.B_Refs.BypassSpeedBtn = SpeedBypassButton

    -- Клик для отключения перезарядки взмаха
    CooldownButton.MouseButton1Click:Connect(function()
        G_Config.NoCooldown.Enabled = not G_Config.NoCooldown.Enabled
        CooldownButton.BackgroundColor3 = G_Config.NoCooldown.Enabled and Color3.fromRGB(76, 175, 80) or Color3.fromRGB(255, 152, 0)
    end)

    -- Клик для включения CFrame-обхода скорости
    SpeedBypassButton.MouseButton1Click:Connect(function()
        G_Config.BypassSpeed.Enabled = not G_Config.BypassSpeed.Enabled
        SpeedBypassButton.BackgroundColor3 = G_Config.BypassSpeed.Enabled and Color3.fromRGB(76, 175, 80) or Color3.fromRGB(255, 152, 0)
    end)
    
    -- УЛЬТРА-БЕЗОПАСНЫЙ ПОТОК ОБХОДА ОГРАНИЧЕНИЙ ДВИЖКА
    HeartbeatService.Heartbeat:Connect(function()
        local character = LocalPlr.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if not rootPart or not humanoid then return end

        -- 1. ЛОГИКА ОТКЛЮЧЕНИЯ ПЕРЕЗАРЯДКИ (Убирает системные тики кулдауна оружия)
        if G_Config.NoCooldown.Enabled then
            pcall(function()
                -- Ищем локальные переменные задержки удара в боевых скриптах персонажа
                local combatScript = character:FindFirstChild("Combat") or character:FindFirstChild("Dribble") or LocalPlr.Backpack:FindFirstChildOfClass("LocalScript")
                if combatScript then
                    -- Продвинутый сброс кулдауна через очистку системного атрибута тиков
                    character:SetAttribute("Cooldown", 0)
                    character:SetAttribute("HitCooldown", false)
                    character:SetAttribute("AttackAnimSpeed", 99)
                end
            end)
        end

        -- 2. ЛОГИКА ОБХОДА СКОРОСТИ ЧЕРЕЗ CFRAME (Не спалится серверным античитом)
        if G_Config.BypassSpeed.Enabled and humanoid.MoveDirection.Magnitude > 0 then
            pcall(function()
                local camCFrame = game:GetService("Workspace").CurrentCamera.CFrame
                local moveVector = Vector3.new(0, 0, 0)
                
                -- Считываем нажатые клавиши управления ходьбой
                if UIS:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCFrame.LookVector end
                if UIS:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCFrame.RightVector end
                if UIS:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCFrame.RightVector end
                
                -- Убираем смещение по высоте, чтобы не улететь в небо при взгляде вверх
                if moveVector.Magnitude > 0 then
                    moveVector = Vector3.new(moveVector.X, 0, moveVector.Z).Unit
                    -- Делаем микро-толчки CFrame со скоростью 45 без изменения WalkSpeed в Humanoid!
                    rootPart.CFrame = rootPart.CFrame + (moveVector * (G_Config.BypassSpeed.Value / 120))
                end
            end)
        end
    end)
    
    print("[Gemini Модуль]: Анти-кулдаун удара и CFrame-скорость успешно добавлены в Утилиты!")
end
