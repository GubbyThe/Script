end)

UIS.InputBegan:Connect(function(input, gpe)
    if not scriptActive then return end
    if Config.GubbyUIBind.Listening and input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode ~= Enum.KeyCode.Escape then 
            Config.GubbyUIBind.Key = input.KeyCode 
            BindBtn.Text = "⌨️ Бинд меню: " .. input.KeyCode.Name 
        end
        Config.GubbyUIBind.Listening = false 
        BindBtn.BackgroundTransparency = 0.5 
        bndStr.Transparency = 0.5 
        BindBtn.TextColor3 = Color3.fromRGB(240, 240, 240) 
        return
    end
    if gpe then return end
    if input.KeyCode == Config.GubbyUIBind.Key then MainFrame.Visible = not MainFrame.Visible end
    if Config.ClickTp.Enabled and input.UserInputType == Enum.UserInputType.MouseButton1 and (UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)) then
        local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local mousePos = UIS:GetMouseLocation()
        local ray = Cam:ViewportPointToRay(mousePos.X, mousePos.Y)
        local res = W:Raycast(ray.Origin, ray.Direction * 1000)
        if root and res then 
            root.CFrame = CFrame.new(res.Position + Vector3.new(0, 3, 0)) 
            root.Velocity = Vector3.zero 
        end
    end
end)

local function refreshGubbyPlayerList()
    for _, item in ipairs(PlScroll:GetChildren()) do 
        if item:IsA("TextButton") then item:Destroy() end 
    end
    local i = 0
    for _, player in ipairs(P:GetPlayers()) do
        if player ~= LP then
            i = i + 1
            local pBtn = Instance.new("TextButton", PlScroll)
            pBtn.Name = "Target_" .. player.Name
            pBtn.Size = UDim2.new(1, -6, 0, 25)
            pBtn.BackgroundTransparency = 0.3
            pBtn.Text = player.Name
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Font = Enum.Font.SourceSansBold
            pBtn.TextSize = 11
            pBtn.TextScaled = true
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            local st = Instance.new("UIStroke", pBtn)
            st.Thickness = 1
            st.Transparency = 0.6
            
            local isSel = Config.Fling.Targets[player]
            pBtn.BackgroundColor3 = isSel and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(40, 40, 45)
            st.Color = isSel and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(0, 255, 150)
            
            pBtn.MouseButton1Click:Connect(function()
                if Config.Fling.Targets[player] then
                    Config.Fling.Targets[player] = nil
                    pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
                    st.Color = Color3.fromRGB(0, 255, 150)
                else
                    Config.Fling.Targets[player] = true
                    pBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                    st.Color = Color3.fromRGB(200, 50, 50)
                end
            end)
        end
    end
    PlScroll.CanvasSize = UDim2.new(0, 0, 0, i * 29)
end

P.PlayerAdded:Connect(refreshGubbyPlayerList)
