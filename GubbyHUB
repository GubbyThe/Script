            bb.Size = UDim2.new(0, 45, 0, 55)
            bb.StudsOffset = Vector3.new(0, 3, 0) -- Высота появления над игроком
            bb.AlwaysOnTop = true -- Прорисовка сквозь любые стены на карте!
