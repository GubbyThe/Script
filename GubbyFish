-- Загрузка библиотеки интерфейса Rayfield напрямую через GitHub RAW
local Rayfield = loadstring(game:HttpGet('https://githubusercontent.com'))()

local Window = Rayfield:CreateWindow({
   Name = "Fisch | Auto-Catch Menu",
   LoadingTitle = "Загрузка меню для Solara...",
   LoadingSubtitle = "by AI Assistant",
   ConfigurationSaving = { Enabled = false }
})

local Tab = Window:CreateTab("Авто-Рыбалка", 4483362458)

local AutoFishEnabled = false

task.spawn(function()
    while task.wait() do
        if AutoFishEnabled then
            pcall(function()
                local localPlayer = game.Players.LocalPlayer
                local character = localPlayer.Character
                local playerGui = localPlayer:WaitForChild("PlayerGui")
                
                -- Auto Shake
                local shakeUI = playerGui:FindFirstChild("ShakeUI")
                if shakeUI and shakeUI.Enabled then
                    local safeButton = shakeUI:FindFirstChild("SafeZone")
                    if safeButton then
                        game:GetService("VirtualUser"):ClickButton1(Vector2.new(9999, 9999))
                    end
                end

                -- Auto Reel (Perfect Catch)
                local reelUI = playerGui:FindFirstChild("ReelUI")
                if reelUI and reelUI.Enabled then
                    local bar = reelUI:FindFirstChild("Bar")
                    local fish = reelUI:FindFirstChild("Fish")
                    
                    if bar and fish then
                        bar.Position = fish.Position
                        local reelEvent = game:GetService("ReplicatedStorage"):FindFirstChild("ReelEvent")
                        if reelEvent then
                            reelEvent:FireServer(100, true)
                        end
                    end
                end
            end)
        end
    end
end)

Tab:CreateToggle({
   Name = "Идеальная ловля (Без промахов)",
   CurrentValue = false,
   Flag = "AutoFishToggle",
   Callback = function(Value)
      AutoFishEnabled = Value
      Rayfield:Notify({
         Title = "Статус авторыбалки",
         Content = Value and "Авторыбалка включена!" or "Авторыбалка выключена.",
         Duration = 3,
         Image = 4483362458,
      })
   end,
})
