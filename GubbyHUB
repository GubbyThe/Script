-- [[ GubbyHUB — Оптимизированная рабочая версия ]] --
local Fluent = loadstring(game:HttpGet("https://github.com"))()

local Window = Fluent:CreateWindow({
    Title = "GubbyHUB",
    SubTitle = "by Gubby",
    TabWidth = 130,
    Size = UDim2.fromOffset(580, 460),
    Theme = "Dark"
})

local Tabs = {
    Player = Window:AddTab({ Title = "Игрок", Icon = "user" }),
    Info = Window:AddTab({ Title = "Инфо", Icon = "info" })
}

-- РАБОЧИЕ ПОЛЗУНКИ ВО ВКЛАДКЕ ИГРОК
Tabs.Player:AddSlider("Speed", {
    Title = "Скорость бега персонажа",
    Min = 16, Max = 250, Default = 16, Rounding = 0,
    Callback = function(Value)
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = Value
        end
    end
})

Tabs.Player:AddSlider("Jump", {
    Title = "Высота прыжка персонажа",
    Min = 50, Max = 300, Default = 50, Rounding = 0,
    Callback = function(Value)
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.UseJumpPower = true
            game.Players.LocalPlayer.Character.Humanoid.JumpPower = Value
        end
    end
})

-- НАША ВКЛАДКА ИНФО
Tabs.Info:AddParagraph({
    Title = "Разработчик проекта: Губби",
    Content = "Автор оригинального концепта. Мы лепили этот проект вместе, как скульпторы!"
})

Fluent:Notify({ Title = "GubbyHUB", Content = "Скрипт успешно запущен!", Duration = 5 })
