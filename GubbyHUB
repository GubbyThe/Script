local function getPlayerRole(p)
    if not p.Character then return "Innocent" end
    if p.Character:FindFirstChild("Knife") or p:FindFirstChild("Backpack"):FindFirstChild("Knife") then return "Murderer" end
    if p.Character:FindFirstChild("Gun") or p:FindFirstChild("Backpack"):FindFirstChild("Gun") then return "Sheriff" end
    return "Innocent"
end

local function handleSmartESP(p)
    if p == LP then return end
    task.spawn(function()
        while task.wait(0.5) do
            if Config.MM2.ESP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local role = getPlayerRole(p)
                local color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or (role == "Sheriff" and Color3.fromRGB(0, 0, 255) or Color3.fromRGB(0, 255, 0))
                
                -- Создание/Обновление жесткого Highlight силуэта
                local hl = p.Character:FindFirstChild("GeminiESP")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "GeminiESP"
                    hl.Parent = p.Character
                end
                hl.FillColor = color
                hl.OutlineColor = color
                hl.FillTransparency = 0.4
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Прорисовка сквозь любые препятствия на карте!
                
                -- Отрисовка никнеймов и ролей над головой
                local head = p.Character:FindFirstChild("Head")
                if head and Config.MM2.NamesESP then
                    local bb = head:FindFirstChild("GeminiName") or Instance.new("BillboardGui", head)
                    bb.Name = "GeminiName"; bb.Size = UDim2.new(0, 120, 0, 30); bb.StudsOffset = Vector3.new(0, 2.5, 0); bb.AlwaysOnTop = true
                    
                    local lbl = bb:FindFirstChildOfClass("TextLabel") or Instance.new("TextLabel", bb)
                    lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1; lbl.Font = Enum.Font.SourceSansBold; lbl.TextSize = 13
                    lbl.Text = p.Name .. " [" .. role .. "]"; lbl.TextColor3 = color
                else
                    if head and head:FindFirstChild("GeminiName") then head.GeminiName:Destroy() end
                end
            else
                -- Если ESP выключено — моментально и начисто удаляем следы из памяти
                if p.Character then
                    if p.Character:FindFirstChild("GeminiESP") then p.Character.GeminiESP:Destroy() end
                    if p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("GeminiName") then p.Character.Head.GeminiName:Destroy() end
                end
            end
        end
    end)
end

-- Моментальная привязка потоков ко всем зашедшим и новым читерам на сервере
