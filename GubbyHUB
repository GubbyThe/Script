    btnStroke.Color = Color3.fromRGB(255, 105, 180)
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5

    -- Логика кнопки ресета
    ResetBtn.MouseButton1Click:Connect(function()
        local defaultGravity = 196.2
        Config.HumanoidMods.Gravity = defaultGravity
        
        if not Config.GubbyFly or not Config.GubbyFly.Enabled then
            W.Gravity = defaultGravity
        end

        -- Плавно передвигаем ползунок обратно на стандартную позицию (~49% заполнения)
        Label.Text = "Гравитация мира: 196"
        local targetPct = defaultGravity / maxVal
        SliderFill.Size = UDim2.new(targetPct, 0, 1, 0)
        Trigger.Position = UDim2.new(targetPct, -6, 0, -3)

        -- Эффект визуального клика
        ResetBtn.BackgroundTransparency = 0.1
        btnStroke.Transparency = 0.1
        task.wait(0.12)
        ResetBtn.BackgroundTransparency = 0.5
        btnStroke.Transparency = 0.5
    end)

    -- 3. ЖЕСТКИЙ ПОТОК ЗАЩИТЫ ОТ СБРОСА ГРАВИТАЦИИ СЕРВЕРОМ
    local gravityActive = true
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        gravityActive = false -- Мгновенно глушим поток при перезапуске хаба
        if oldKill then oldKill() end
    end

    task.spawn(function()
        while gravityActive do
            task.wait(0.4) -- Лёгкий цикл опроса раз в 0.4 секунды
            if not gravityActive then break end
            
            -- Если полет выключен, принудительно держим гравитацию из ползунка
            if Config.HumanoidMods.Gravity and (not Config.GubbyFly or not Config.GubbyFly.Enabled) then
                if W.Gravity ~= Config.HumanoidMods.Gravity then
                    W.Gravity = Config.HumanoidMods.Gravity
                end
            end
        end
    end)

    print("[Gubby Модуль]: Ползунок и кнопка сброса гравитации успешно добавлены во вкладку 'Игрок'!")
