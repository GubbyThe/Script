        end
    end)

    -- 2. ИЗОЛИРОВАННЫЙ СТАБИЛЬНЫЙ ПОТОК ОТРИСОВКИ ЛИНИЙ С ФЛАГОМ ОСТАНОВКИ
    -- Мы привязываемся к той же функции зачистки старых потоков при ре-инжекте
    local tracersActive = true
    
    -- Интегрируем стоп-флаг тросов в твою прошлую глобальную функцию очистки памяти
    local oldKill = _G.GubbyKillOldStreams
    _G.GubbyKillOldStreams = function()
        tracersActive = false -- Останавливаем этот поток линий при перезапуске
        if oldKill then oldKill() end
    end

    task.spawn(function()
        local activeLines = {}

        while tracersActive do
            RS.Heartbeat:Wait()
            
            -- Если сработал глобальный ресет скрипта — принудительно выходим из цикла
            if not tracersActive then break end

            if Config.GubbyTracers.Enabled then
                for _, player in ipairs(P:GetPlayers()) do
                    if player ~= LP and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local root = player.Character.HumanoidRootPart
                        local screenPos, onScreen = Cam:WorldToViewportPoint(root.Position)

                        if onScreen then
                            local line = activeLines[player]
                            if not line then
                                -- Рисуем чистый белый трос
                                line = Drawing.new("Line")
                                line.Thickness = 1.2
                                line.Transparency = 0.8
                                line.Color = Color3.fromRGB(255, 255, 255) -- Белый цвет под шерсть кролика
                                activeLines[player] = line
                            end

                            -- Начало линии: снизу по центру экрана, конец: таз игрока
                            line.From = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y)
                            line.To = Vector2.new(screenPos.X, screenPos.Y)
                            line.Visible = true
                        else
                            if activeLines[player] then activeLines[player].Visible = false end
                        end
                    else
                        if activeLines[player] then pcall(function() activeLines[player]:Remove() end) activeLines[player] = nil end
                    end
                end
            else
                -- Если тросы просто выключили кнопкой — гасим линии и чистим таблицу
                for p, line in pairs(activeLines) do pcall(function() line:Remove() end) end
                table.clear(activeLines)
            end
        end

        -- Финальный аккорд: если поток закрывается совсем (перезапуск хаба) — полностью стираем все линии с экрана
        for p, line in pairs(activeLines) do pcall(function() line:Remove() end) end
        table.clear(activeLines)
    end)

    print("[Gubby Модуль]: Белые тросы успешно возвращены с двойной защитой памяти!")
else
    print("[Gubby Ошибка]: Не удалось найти вкладку 'Визуалы'!")
end
