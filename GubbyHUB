RS.Stepped:Connect(function()
    if not scriptActive then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if hum and root then
        if not Config.GubbyFly.Enabled then 
            hum.WalkSpeed = Config.PlayerMods.Speed 
            hum.JumpPower = Config.PlayerMods.Jump 
        end
        if Config.GubbyNoclip.Enabled then 
            for _, part in pairs(char:GetDescendants()) do 
                if part:IsA("BasePart") then part.CanCollide = false end 
            end 
        end
        if Config.GubbyFly.Enabled then
            hum.PlatformStand = true
            local moveDir = hum.MoveDirection
            local cameraCFrame = Cam.CFrame
            local flyVelocity = Vector3.zero
            if moveDir.Magnitude > 0 then 
                flyVelocity = cameraCFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z).Unit * Config.GubbyFly.Speed) 
            end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then 
                flyVelocity = flyVelocity + Vector3.new(0, Config.GubbyFly.Speed, 0) 
            elseif UIS:IsKeyDown(Enum.KeyCode.LeftShift) then 
                flyVelocity = flyVelocity - Vector3.new(0, Config.GubbyFly.Speed, 0) 
            end
            root.Velocity = flyVelocity
        else
            if hum.PlatformStand then hum.PlatformStand = false end
        end
    end
end)

