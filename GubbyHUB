tabSettings:CreateTextBox("Клавиша Полёта (Fly)", "F", function(t) if #t == 1 then Config.KeyBinds.Fly.Key = t:upper() _G.SaveGubbyConfig() end end)
tabSettings:CreateTextBox("Клавиша Ноклипа", "V", function(t) if #t == 1 then Config.KeyBinds.Noclip.Key = t:upper() _G.SaveGubbyConfig() end end)
tabSettings:CreateTextBox("Клавиша Инф.Прыжка", "B", function(t) if #t == 1 then Config.KeyBinds.InfJump.Key = t:upper() _G.SaveGubbyConfig() end end)
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if Config.GubbyUIBind.Listening and input.UserInputType == Enum.UserInputType.Keyboard then
        Config.GubbyUIBind.Key = input.KeyCode Config.GubbyUIBind.Listening = false _G.SaveGubbyConfig() return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local k = input.KeyCode.Name
        if input.KeyCode == Config.GubbyUIBind.Key then MainFrame.Visible = not MainFrame.Visible
        elseif k == Config.KeyBinds.Fly.Key then Config.GubbyFly.Enabled = not Config.GubbyFly.Enabled
        elseif k == Config.KeyBinds.Noclip.Key then Config.GubbyNoclip.Enabled = not Config.GubbyNoclip.Enabled
        elseif k == Config.KeyBinds.InfJump.Key then Config.InfJump.Enabled = not Config.InfJump.Enabled end
    end
end)
task.spawn(function()
    while scriptActive do
        if Config.GubbyFly.Enabled and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            W.Gravity = 0 local md = Vector3.new(0,0,0)
            if UIS:IsKeyDown(Enum.KeyCode.W) then md = md + Cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then md = md - Cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then md = md - Cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then md = md + Cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then md = md + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then md = md - Vector3.new(0,1,0) end
            LP.Character.HumanoidRootPart.Velocity = md.Unit * Config.GubbyFly.Speed
            if md.Magnitude == 0 then LP.Character.HumanoidRootPart.Velocity = Vector3.new(0,0,0) end
        else if W.Gravity == 0 then W.Gravity = Config.PlayerMods.Gravity end end
        task.wait()
    end
end)

print("[Gubby Hub]: Скрипт полностью обновлен и готов к работе!")
